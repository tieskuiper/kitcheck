---
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/dm-sans/300.css";
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/400-italic.css";
import "../styles/global.css";
import CookieBanner from "../components/CookieBanner.astro";
// The headline weight: preloaded so the H1 (the largest element on most pages) renders in the right font straight away
import headingFont from "@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url";
import { SITE_URL, siteGraph, CONTENT_UPDATED } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /** WebApplication structured data — only for the page that IS the tool (homepage) */
  appSchema?: boolean;
  /** Page-specific structured data nodes (Article, FAQPage, BreadcrumbList…), merged into one @graph */
  schema?: object[];
  lang?: "en" | "nl";
  /** The same page in other languages, for hreflang */
  alternates?: { lang: string; href: string }[];
  /** Guide articles: og:type article with publish/modify dates */
  article?: boolean;
  /** Publish date for article:published_time (defaults to CONTENT_UPDATED, i.e. new pages) */
  published?: string;
  /** Keep out of search results (404) */
  noindex?: boolean;
}
const {
  title = "Cycling Kit Calculator: What to Wear Cycling by Temperature | kitcheck.cc",
  description = "Free cycling kit calculator. Search your city, set your ride intensity and get a full kit list in seconds.",
  canonical = "https://kitcheck.cc/",
  appSchema = false,
  schema = [],
  lang = "en",
  alternates = [],
  article = false,
  published = CONTENT_UPDATED,
  noindex = false,
} = Astro.props;
const appNode = {
  "@type": "WebApplication",
  "@id": `${SITE_URL}/#app`,
  name: "kitcheck.cc cycling kit calculator",
  url: canonical,
  description,
  applicationCategory: "SportsApplication",
  operatingSystem: "Any",
  inLanguage: lang,
  isAccessibleForFree: true,
  browserRequirements: "Requires JavaScript. Works in any modern browser; no app or account needed.",
  featureList: [
    "Kit list for head, upper body, hands, legs and feet",
    "Hourly forecast for the whole ride window, up to 7 days ahead",
    "Adjusts for effort (easy to race) and how warm you run",
    "Wind and rain scaled to the temperature",
    "GPX routes: forecast along the route, headwind and descents",
    "°C and °F",
  ],
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  publisher: { "@id": `${SITE_URL}/#organization` },
};
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [...siteGraph(), ...(appSchema ? [appNode] : []), ...schema],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={article ? "article" : "website"} />
    {article && <meta property="article:published_time" content={published} />}
    {article && <meta property="article:modified_time" content={CONTENT_UPDATED} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="kitcheck.cc" />
    <meta property="og:locale" content={lang === "nl" ? "nl_NL" : "en_US"} />
    <meta property="og:image" content="https://kitcheck.cc/og.png" />
    <meta property="og:image:alt" content="kitcheck.cc — cycling kit calculator" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://kitcheck.cc/og.png" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large"} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    {
      alternates.length > 0 && [
        ...alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />),
        <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.lang === "en")?.href ?? canonical} />,
      ]
    }
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
    <!-- Google Analytics loads only after consent: see lib/consent.ts + CookieBanner -->
  </head>
  <body class="bg-bg text-text min-h-screen flex flex-col">
    <slot name="header" />
    <main class="flex-1">
      <slot />
    </main>
    <slot name="footer" />
    <CookieBanner />
  </body>
</html>
