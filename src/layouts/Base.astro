---
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}
const {
  title = "kitcheck.cc — Know exactly what to wear before you ride",
  description = "Free cycling kit calculator. Search your city, set your ride intensity and get a full kit list in seconds.",
  canonical = "https://kitcheck.cc",
} = Astro.props;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "kitcheck.cc",
  url: "https://kitcheck.cc",
  description,
  applicationCategory: "SportsApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="kitcheck.cc" />
    <meta property="og:image" content="https://kitcheck.cc/og.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://kitcheck.cc/og.svg" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,400&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,400&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6RTFTTVF3G"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-6RTFTTVF3G');
    </script>
  </head>
  <body class="bg-bg text-text min-h-screen flex flex-col">
    <main>
      <slot />
    </main>
  </body>
</html>
