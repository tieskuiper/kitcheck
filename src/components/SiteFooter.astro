---
const columns = [
  {
    title: "Tool",
    links: [
      { label: "Kit calculator", href: "/" },
      { label: "Temperature chart", href: "/guide/cycling-temperature-chart/" },
      { label: "How it works", href: "/how-it-works/" },
    ],
  },
  {
    title: "Guide",
    links: [
      { label: "Kit by temperature", href: "/guide/" },
      { label: "Rain", href: "/guide/what-to-wear-cycling-in-the-rain/" },
      { label: "Winter", href: "/guide/winter-cycling-clothing/" },
      { label: "Summer", href: "/guide/summer-cycling-clothing/" },
    ],
  },
  {
    title: "kitcheck.cc",
    links: [
      { label: "About", href: "/about/" },
      { label: "Privacy", href: "/privacy/" },
      { label: "Cookies", href: "/cookies/" },
    ],
  },
];
---

<footer class="bg-bg-dark text-white mt-auto">
  <div class="container">
    <div class="grid grid-cols-2 md:grid-cols-[1.5fr_repeat(3,1fr)] gap-x-6 gap-y-8 py-12">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="font-head font-bold text-lg tracking-tight hover:opacity-80 transition-opacity">
          kitcheck<span class="text-coral">.cc</span>
        </a>
        <p class="text-sm text-white/55 leading-relaxed mt-2 max-w-xs">
          Know exactly what to wear before you ride.
        </p>
      </div>
      {columns.map((col) => (
        <nav aria-label={col.title}>
          <p class="font-head text-[11px] font-semibold tracking-[0.08em] uppercase text-white/40 mb-3">{col.title}</p>
          <ul class="space-y-2">
            {col.links.map((l) => (
              <li><a href={l.href} class="text-sm text-white/70 hover:text-white transition-colors">{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="flex flex-wrap justify-between gap-3 py-5 border-t border-white/10">
      <span class="text-xs text-white/50">
        © 2026 kitcheck.cc · Weather by <a href="https://open-meteo.com" target="_blank" rel="noopener" class="text-white/50 hover:text-white/80">Open-Meteo</a> · Free to use
      </span>
      <div class="flex items-center gap-4">
        <a href="/sitemap/" class="text-xs text-white/50 hover:text-white/80 transition-colors">Sitemap</a>
        <button type="button" data-consent-open class="text-xs text-white/50 hover:text-white/80 transition-colors cursor-pointer bg-transparent border-0 p-0">Cookie settings</button>
      </div>
    </div>
  </div>
</footer>

<script>
  import { openConsentSettings } from '../lib/consent'
  document.querySelectorAll('[data-consent-open]').forEach(el => el.addEventListener('click', openConsentSettings))
</script>
