---
interface Props { title?: string; text?: string; href?: string; label?: string }
const {
  title = "Check the forecast for your ride",
  text = "The calculator uses the hourly forecast for your location and ride window, including wind, rain and how hard you're going.",
  href = "/",
  label = "Use the calculator",
} = Astro.props;
---

<section class="bg-bg">
  <div class="container py-14 md:py-20">
    <div class="relative overflow-hidden rounded-3xl bg-bg-dark px-6 py-10 sm:px-10 md:px-14 md:py-14">
      <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-24 size-[420px] rounded-full bg-coral/25 blur-3xl"></div>
      <div class="relative flex flex-col md:flex-row md:items-center justify-between gap-8">
        <div class="max-w-xl">
          <p class="font-head font-bold text-2xl md:text-3xl tracking-tight text-white mb-3 text-balance">{title}</p>
          <p class="text-white/65 leading-relaxed">{text}</p>
        </div>
        <a href={href} class="btn-primary py-3! px-5! text-[14px]! shrink-0">{label} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>
