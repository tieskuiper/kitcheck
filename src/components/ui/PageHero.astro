---
/**
 * Page hero: breadcrumb, road-marking label, title, lead, actions (default slot) and an
 * optional aside (named slot "aside"). A faint stage profile runs along the bottom.
 */
import Breadcrumb from "../guide/Breadcrumb.astro";
import RouteProfile from "../brand/RouteProfile.astro";

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  crumbs?: { name: string; href?: string }[];
  align?: "left" | "center";
}
const { title, eyebrow, lead, crumbs, align = "left" } = Astro.props;
const hasAside = Astro.slots.has("aside");
const center = align === "center";
---

<section class="relative overflow-hidden bg-bg">
  <RouteProfile variant="hero" class="absolute inset-x-0 bottom-0 h-36 md:h-48" />

  <div class="container relative">
    <div class={`pt-10 md:pt-14 lg:pt-16 pb-24 md:pb-32 ${hasAside ? "grid grid-cols-1 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] gap-10 lg:gap-14 items-center" : ""}`}>
      <div class={center ? "max-w-3xl mx-auto text-center" : "max-w-2xl"}>
        {crumbs && <div class={center ? "flex justify-center" : ""}><Breadcrumb items={crumbs} /></div>}
        {eyebrow && <p class={`road-label mb-5 ${center ? "justify-center" : ""}`}>{eyebrow}</p>}
        <h1 class="font-head text-[2.25rem] md:text-5xl lg:text-[3.75rem] font-bold tracking-[-0.035em] leading-[1.02] text-text text-balance">
          <Fragment set:html={title} />
        </h1>
        {lead && <p class={`text-lg text-text-mid leading-relaxed mt-5 ${center ? "max-w-xl mx-auto" : ""}`}>{lead}</p>}
        {Astro.slots.has("default") && (
          <div class={`flex flex-wrap gap-3 mt-7 ${center ? "justify-center" : ""}`}><slot /></div>
        )}
      </div>
      {hasAside && <div class="min-w-0"><slot name="aside" /></div>}
    </div>
  </div>
</section>
