---
/**
 * Hero for every page except the homepage (which goes straight into the tool): a separate white
 * band with a bottom border, left-aligned. Breadcrumb, eyebrow, title, lead, actions (default
 * slot) and an optional aside (named slot "aside") next to the text on desktop.
 * The section after it should use the page background (bg-bg) so the band stands apart.
 */
import Breadcrumb from "../guide/Breadcrumb.astro";
import { CONTENT_UPDATED } from "../../lib/site";

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  crumbs?: { name: string; href?: string }[];
  /** Last-updated line, for articles (freshness signal for search engines and AI tools) */
  byline?: boolean;
}
const { title, eyebrow, lead, crumbs, byline = false } = Astro.props;
const hasAside = Astro.slots.has("aside");
const updated = new Date(CONTENT_UPDATED).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<section class="bg-white border-b border-border">
  <div class="container">
    <div class="pt-8 md:pt-10 pb-14 md:pb-20">
      {crumbs && <Breadcrumb items={crumbs} />}
      <div class={hasAside ? "grid grid-cols-1 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] gap-10 lg:gap-16 items-start mt-6 md:mt-10" : "mt-6 md:mt-10"}>
        <div class="max-w-2xl">
          {eyebrow && <p class="font-head text-[12px] font-semibold tracking-[0.08em] uppercase text-coral mb-4">{eyebrow}</p>}
          <h1 class="font-head text-[2.125rem] md:text-5xl lg:text-[3.25rem] font-bold tracking-tight leading-[1.06] text-text text-balance">
            <Fragment set:html={title} />
          </h1>
          {lead && <p class="text-lg text-text-mid leading-relaxed mt-5 max-w-xl">{lead}</p>}
          {byline && (
            <p class="text-[13px] text-text-light mt-4">
              Updated <time datetime={CONTENT_UPDATED}>{updated}</time>
            </p>
          )}
          {Astro.slots.has("default") && <div class="flex flex-wrap gap-3 mt-8"><slot /></div>}
        </div>
        {hasAside && <div class="min-w-0"><slot name="aside" /></div>}
      </div>
    </div>
  </div>
</section>
