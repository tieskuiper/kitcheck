---
import RouteProfile from "../brand/RouteProfile.astro";
interface Props { title: string; eyebrow?: string; lead?: string; align?: "left" | "center"; id?: string }
const { title, eyebrow, lead, align = "left", id } = Astro.props;
const center = align === "center";
---

<div class={`mb-8 md:mb-10 ${center ? "max-w-2xl mx-auto text-center" : "max-w-2xl"}`}>
  {eyebrow && <p class={`road-label mb-3 ${center ? "justify-center" : ""}`}>{eyebrow}</p>}
  <h2 id={id} class="scroll-mt-24 font-head font-bold text-[1.75rem] md:text-[2.25rem] tracking-[-0.03em] leading-[1.08] text-text text-balance">{title}</h2>
  <RouteProfile variant="rule" class={`mt-3 ${center ? "mx-auto" : ""}`} />
  {lead && <p class="text-text-mid leading-relaxed mt-3">{lead}</p>}
</div>
