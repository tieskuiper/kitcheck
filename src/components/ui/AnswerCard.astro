---
/** The quotable one-paragraph answer at the top of an article, styled as a note on the stem */
interface Props { text: string; label?: string }
const { text, label = "The short answer" } = Astro.props;
---

<div class="relative bg-white rounded-[6px] border border-black/10 pl-6 pr-5 py-5 sm:pl-7 sm:pr-6 shadow-[0_1px_0_rgba(0,0,0,0.04),0_16px_32px_-20px_rgba(0,0,0,0.25)]">
  <span class="absolute left-0 inset-y-4 w-1 rounded-r-full bg-coral" aria-hidden="true"></span>
  <p class="road-label mb-2">{label}</p>
  <p class="text-[15px] text-text leading-relaxed">{text}</p>
</div>
