---
import { existsSync } from "node:fs";

const INSTAGRAM_URL = "https://www.instagram.com/raasracingteam/";

// Drop the team logo in public/ under one of these names and it replaces the wordmark
const logo = ["raas-racing-team.svg", "raas-racing-team.png"].find((f) =>
  existsSync(`public/${f}`),
);
---

<section class="bg-bg" aria-labelledby="team-cta-title">
  <div class="container pb-12 md:pb-16">
    <div class="relative overflow-hidden rounded-2xl bg-linear-to-br from-team-night from-45% to-team-forest text-white">
      <!-- Race-kit stripes, petrol → teal → lagoon (decorative). Desktop: diagonal bands; mobile: top bar -->
      <div class="pointer-events-none absolute inset-y-0 right-0 hidden md:block w-[38%]" aria-hidden="true">
        <div class="stripe left-[12%] bg-team-petrol"></div>
        <div class="stripe left-[38%] bg-team-teal"></div>
        <div class="stripe left-[64%] bg-team-lagoon"></div>
      </div>
      <div class="flex h-1.5 md:hidden" aria-hidden="true">
        <div class="flex-1 bg-team-petrol"></div>
        <div class="flex-1 bg-team-teal"></div>
        <div class="flex-1 bg-team-lagoon"></div>
      </div>

      <div class="relative flex flex-col md:flex-row md:items-center gap-6 md:gap-8 p-6 sm:p-8 md:p-10">
        <!-- Logo or wordmark -->
        <div class="shrink-0">
          {
            logo ? (
              <img src={`/${logo}`} alt="Raas Racing Team" class="h-16 md:h-20 w-auto" loading="lazy" decoding="async" />
            ) : (
              <div class="inline-flex flex-col leading-none font-head border-l-4 border-team-lagoon pl-3" aria-hidden="true">
                <span class="text-[30px] md:text-[36px] font-bold tracking-[-0.03em]">RAAS</span>
                <span class="text-[11px] font-semibold tracking-[0.22em] text-white/70 mt-1">RACING TEAM</span>
              </div>
            )
          }
        </div>

        <!-- Copy -->
        <div class="flex-1 min-w-0 md:max-w-[52%]">
          <p class="font-head text-[11px] font-semibold tracking-[0.12em] uppercase text-team-lagoon mb-2">
            Rider-tested
          </p>
          <h2 id="team-cta-title" class="font-head text-2xl md:text-[28px] font-bold tracking-tight leading-[1.15] mb-2">
            Raas Racing Team rides with KitCheck
          </h2>
          <p class="text-sm md:text-[15px] text-white/70 leading-relaxed max-w-xl">
            The team's riders use KitCheck to decide what to wear before training rides and
            races. Follow their season on Instagram.
          </p>
        </div>

        <!-- CTA -->
        <a
          href={INSTAGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-team-instagram
          class="relative shrink-0 inline-flex items-center justify-center gap-2.5 self-start md:self-center rounded-xl bg-white text-team-night px-5 py-3 shadow-[0_6px_24px_rgba(0,0,0,0.35)] font-head text-[14px] font-bold transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
          </svg>
          Follow @raasracingteam
          <span class="sr-only">(opens Instagram in a new tab)</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .stripe {
    position: absolute;
    top: -20%;
    bottom: -20%;
    width: 18%;
    transform: skewX(-18deg);
  }
</style>

<script>
  import { track } from "../lib/consent";

  // Plain link, no Instagram embed: nothing loads from Instagram until someone clicks
  document.querySelector("[data-team-instagram]")?.addEventListener("click", () => {
    track("team_instagram_click");
  });
</script>
