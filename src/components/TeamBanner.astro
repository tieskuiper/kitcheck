---
import Wordmark from "../assets/raas/wordmark.svg";
import Signature from "../assets/raas/signature.svg";
import Emblem from "../assets/raas/emblem.svg";

const INSTAGRAM_URL = "https://www.instagram.com/raasracingteam/";
---

<section class="bg-bg" aria-labelledby="team-cta-title">
  <div class="container pb-12 md:pb-16">
    <div class="relative overflow-hidden rounded-2xl bg-linear-to-br from-team-night from-45% to-team-forest text-white md:grid md:grid-cols-[1fr_38%]">
      <!-- Mobile: kit stripes as a top bar + faint emblem watermark -->
      <div class="flex h-1.5 md:hidden" aria-hidden="true">
        <div class="flex-1 bg-team-petrol"></div>
        <div class="flex-1 bg-team-teal"></div>
        <div class="flex-1 bg-team-lagoon"></div>
      </div>
      <Emblem
        aria-hidden="true"
        class="md:hidden pointer-events-none absolute -right-12 bottom-6 w-72 h-auto text-white opacity-[0.07]"
      />

      <!-- Content -->
      <div class="relative p-6 sm:p-8 md:p-10 lg:p-12">
        <Wordmark role="img" aria-label="Raas Racing Team" class="h-12 md:h-14 w-auto text-white mb-6 md:mb-7" />

        <p class="font-head text-[11px] font-semibold tracking-[0.12em] uppercase text-team-lagoon mb-2">
          Rider-tested
        </p>
        <h2 id="team-cta-title" class="font-head text-2xl md:text-[28px] font-bold tracking-tight leading-[1.15] mb-2">
          Raas Racing Team rides with KitCheck
        </h2>
        <p class="text-sm md:text-[15px] text-white/70 leading-relaxed max-w-lg">
          The team's riders use KitCheck to decide what to wear before training rides and
          races. Follow their season on Instagram.
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a
            href={INSTAGRAM_URL}
            target="_blank"
            rel="noopener noreferrer"
            data-team-instagram
            class="inline-flex items-center justify-center gap-2.5 rounded-xl bg-white text-team-night px-5 py-3 font-head text-[14px] font-bold shadow-[0_6px_24px_rgba(0,0,0,0.35)] transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
            </svg>
            Follow @raasracingteam
            <span class="sr-only">(opens Instagram in a new tab)</span>
          </a>

          <!-- Team sign-off -->
          <div class="flex items-center gap-3">
            <Signature aria-hidden="true" class="h-10 w-auto text-team-lagoon -rotate-6" />
            <span class="font-head text-[10px] font-semibold tracking-[0.14em] uppercase text-white/50 leading-tight">
              Approved by<br />the riders
            </span>
          </div>
        </div>
      </div>

      <!-- Desktop: kit stripes with the R·R·T emblem as the team badge -->
      <div class="relative hidden md:block" aria-hidden="true">
        <div class="stripe left-[4%] bg-team-petrol"></div>
        <div class="stripe left-[34%] bg-team-teal"></div>
        <div class="stripe left-[64%] bg-team-lagoon"></div>
        <div class="absolute inset-0 flex items-center justify-center">
          <Emblem class="emblem w-[82%] max-w-80 h-auto text-white" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .stripe {
    position: absolute;
    top: -20%;
    bottom: -20%;
    width: 22%;
    transform: skewX(-18deg);
  }
  .emblem {
    filter: drop-shadow(0 10px 28px rgba(1, 13, 20, 0.55));
  }
</style>

<script>
  import { track } from "../lib/consent";

  // Plain link, no Instagram embed: nothing loads from Instagram until someone clicks
  document.querySelector("[data-team-instagram]")?.addEventListener("click", () => {
    track("team_instagram_click");
  });
</script>
