---
/**
 * A temperature as a race number: paper bib with four safety-pin holes and the
 * tier colour as the sponsor band. Hover tilts it like a pinned number in the wind.
 */
import { TIER_ACCENT } from "../calculator/constants";
interface Props { href: string; value: string; sub?: string; tier: string; note?: string; current?: boolean; size?: "lg" | "sm" }
const { href, value, sub, tier, note, current = false, size = "lg" } = Astro.props;
const color = TIER_ACCENT[tier] ?? "#FF5130";
---

<a href={href} aria-current={current ? "page" : undefined}
  class:list={["bib group relative flex flex-col bg-white border rounded-[6px] transition-transform duration-200",
    current ? "border-coral ring-2 ring-coral/20" : "border-black/10 hover:-rotate-[1.5deg] hover:-translate-y-0.5",
    size === "lg" ? "px-4 pt-3.5 pb-4" : "px-3 pt-2.5 pb-3"]}>
  <span class="pin left-2 top-2"></span><span class="pin right-2 top-2"></span>
  <span class="pin left-2 bottom-2"></span><span class="pin right-2 bottom-2"></span>
  <span class="block h-[5px] rounded-full mx-3" style={`background:${color}`}></span>
  <span class:list={["font-head font-bold tracking-tighter text-text text-center leading-none tabular-nums", size === "lg" ? "text-[2.5rem] mt-3" : "text-2xl mt-2"]}>{value}</span>
  {sub && <span class="text-center text-[11px] font-head font-semibold text-text-light mt-1 tabular-nums">{sub}</span>}
  {note && <span class="text-center text-[12px] text-text-mid leading-snug mt-3 flex-1">{note}</span>}
  <span class:list={["text-center font-head font-bold uppercase tracking-[0.12em]", size === "lg" ? "text-[9px] mt-3" : "text-[8px] mt-1.5"]} style={`color:${color}`}>{tier}</span>
</a>

<style>
  .pin {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--color-bg);
    box-shadow: inset 0 1px 1px rgb(0 0 0 / 0.25);
  }
</style>
