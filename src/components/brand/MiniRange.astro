---
/** A small temperature scale (-10 to 30°C) with the item's range marked: solid = wear, striped = optional */
import type { ItemRanges } from "../../lib/kitRanges";
import { THERMO_GRADIENT } from "../../lib/brand";
interface Props { ranges: ItemRanges }
const { ranges } = Astro.props;
const MIN = -10, MAX = 30;
const pct = (c: number | null, fallback: number) => ((Math.min(MAX, Math.max(MIN, c ?? fallback)) - MIN) / (MAX - MIN)) * 100;
const seg = (r: { from: number | null; to: number | null }) => {
  const a = pct(r.from, MIN), b = pct(r.to, MAX);
  return `left:${a}%;width:${b - a}%`;
};
---

<div class="relative h-2.5" aria-hidden="true">
  <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-[3px] rounded-full opacity-35" style={`background:${THERMO_GRADIENT}`}></div>
  {ranges.optional && <span class="absolute inset-y-0 rounded-full bar-optional" style={seg(ranges.optional)}></span>}
  {ranges.required && <span class="absolute inset-y-0 rounded-full bg-coral" style={seg(ranges.required)}></span>}
</div>
<div class="flex justify-between mt-1 font-head text-[9px] font-semibold text-text-light tabular-nums" aria-hidden="true">
  <span>-10°</span><span>0°</span><span>10°</span><span>20°</span><span>30°</span>
</div>
