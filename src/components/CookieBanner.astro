---
---

<div
  id="cookie-banner"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cookie-banner-title"
  aria-describedby="cookie-banner-text"
  class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-border shadow-[0_-4px_24px_rgba(0,0,0,0.06)] px-4 py-4 hidden"
>
  <div class="container">
    <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6">
      <div class="flex-1">
        <p id="cookie-banner-title" class="font-head text-sm font-bold text-text mb-1">Analytics cookies</p>
        <p id="cookie-banner-text" class="text-text-mid text-sm leading-relaxed">
          Can we use Google Analytics to see how the calculator is used? It sets cookies and
          shares usage data with Google. You can change your choice any time via <em>Cookie settings</em> at the bottom of each page. <a href="/cookies/" class="underline hover:opacity-75 transition-opacity">Cookie policy</a>
        </p>
      </div>
      <!-- Equal weight on purpose: declining must be as easy as accepting -->
      <div class="flex gap-2 shrink-0 justify-end">
        <button id="cookie-decline" type="button" class="btn-secondary min-w-[96px]">Decline</button>
        <button id="cookie-accept" type="button" class="btn-secondary min-w-[96px]">Accept</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { getConsent, setConsent, loadAnalytics, type ConsentStatus } from '../lib/consent'

  const banner = document.getElementById('cookie-banner')!
  const acceptBtn = document.getElementById('cookie-accept')!
  const declineBtn = document.getElementById('cookie-decline')!

  const show = (focus: boolean) => {
    banner.classList.remove('hidden')
    if (focus) declineBtn.focus()
  }
  const choose = (status: ConsentStatus) => {
    setConsent(status)
    banner.classList.add('hidden')
  }

  const consent = getConsent()
  if (consent === 'accepted') loadAnalytics()
  else if (consent === null) show(false)

  acceptBtn.addEventListener('click', () => choose('accepted'))
  declineBtn.addEventListener('click', () => choose('declined'))
  window.addEventListener('kitcheck:consent-open', () => show(true))
  banner.addEventListener('keydown', e => { if (e.key === 'Escape' && getConsent() !== null) banner.classList.add('hidden') })
</script>
