---
interface Props { heading: string; links: { label: string; href: string; current?: boolean }[]; more?: { label: string; href: string } }
const { heading, links, more } = Astro.props;
---

<section class="bg-bg border-t border-border">
  <div class="container py-12 md:py-14">
    <h2 class="font-head font-bold text-xl text-text mb-4">{heading}</h2>
    <nav class="flex flex-wrap gap-2" aria-label={heading}>
      {links.map((l) =>
        l.current ? (
          <span aria-current="page" class="px-4 py-2 rounded-[10px] border-[1.5px] border-coral bg-coral/[6%] font-head text-sm font-semibold text-coral">{l.label}</span>
        ) : (
          <a href={l.href} class="px-4 py-2 rounded-[10px] border-[1.5px] border-border font-head text-sm font-semibold text-text-mid hover:border-text-light transition-colors">{l.label}</a>
        ),
      )}
      {more && <a href={more.href} class="px-4 py-2 font-head text-sm font-semibold text-coral hover:opacity-75 transition-opacity">{more.label} →</a>}
    </nav>
  </div>
</section>
