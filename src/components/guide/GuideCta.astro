---
interface Props { title?: string; text?: string }
const {
  title = "Check the forecast for your ride",
  text = "The calculator uses the hourly forecast for your location and ride window, including wind, rain and how hard you're going.",
} = Astro.props;
---

<section class="bg-bg-dark">
  <div class="container py-12 md:py-14">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      <div>
        <p class="font-head font-bold text-xl text-white mb-1">{title}</p>
        <p class="text-sm text-white/60 max-w-xl">{text}</p>
      </div>
      <a href="/" class="btn-primary shrink-0">Use the calculator</a>
    </div>
  </div>
</section>
