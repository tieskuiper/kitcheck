---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../SiteHeader.astro";
import SiteFooter from "../SiteFooter.astro";
import KitCard from "../calculator/KitCard";
import FaqList from "./FaqList.astro";
import PageHero from "../ui/PageHero.astro";
import AnswerCard from "../ui/AnswerCard.astro";
import SectionHead from "../ui/SectionHead.astro";
import CtaBand from "../ui/CtaBand.astro";
import { TIER_ACCENT } from "../calculator/constants";
import { IconRacingFlag, IconBlip, IconWind, IconRainy, IconSnowFlakes, IconSun } from "@central-icons-react/round-outlined-radius-3-stroke-2";
import {
  TEMP_PAGES, ZONE_LABELS, kitAt, conditionsAt, variationsAt,
  toF, pathFor, kitSentence, listJoin,
} from "../../lib/guideData";
import { abs, articleNode, breadcrumbNode, faqNode } from "../../lib/site";

interface Props { tempC: number; intro: string }
const { tempC: c, intro } = Astro.props;

const label = `${c}°C`;
const other = `${toF(c)}°F`;
const kit = kitAt(c);
const score = conditionsAt(c);
const variations = variationsAt(c);
const canonical = abs(pathFor(c));

const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
// One headline item per zone keeps descriptions distinct between neighbouring temperatures;
// drop items from the end until it fits Google's ~155-character snippet
const headline = (["torso", "legs", "hands", "feet"] as const)
  .map((z) => kit[z].items.find((i) => !i.optional)?.name)
  .filter((n): n is string => !!n)
  .map(lower);
const describe = (items: string[]) =>
  `What to wear cycling at ${label} (${other}): ${items.join(", ")}. Plus what changes with wind, rain and effort.`;
let items = headline;
while (describe(items).length > 155 && items.length > 2) items = items.slice(0, -1);
const description = describe(items);

const h1 = `What to wear cycling at ${label}`;
const answer = kitSentence(kit);
const rain = variations.find((v) => v.key === "rain");
const race = variations.find((v) => v.key === "race");
const changeText = (v: typeof rain) =>
  v && v.changes.length
    ? v.changes.map((ch) => `${ZONE_LABELS[ch.zone].toLowerCase()}: ${listJoin(ch.items.map((i) => lower(i.name) + (i.optional ? " (optional)" : "")))}`).join("; ")
    : null;

// Generated from the same logic as the kit card, so the answers can't drift from the calculator
const faq = [
  { q: `What should I wear cycling at ${label} (${other})?`, a: `At a moderate pace in light wind and no rain: ${answer}` },
  { q: `Do I need gloves cycling at ${label}?`, a: kitSentence(kit, ["hands"]) },
  { q: `Shorts or tights at ${label}?`, a: kitSentence(kit, ["legs"]) },
  ...(changeText(rain) ? [{ q: `What changes if it rains at ${label}?`, a: `With rain likely, change this: ${changeText(rain)}.` }] : []),
  ...(changeText(race) ? [{ q: `What if I ride hard at ${label}?`, a: `At race pace or on a fast group ride you warm up a lot more. Change this: ${changeText(race)}.` }] : []),
];

const siblings = TEMP_PAGES.map((p) => ({ label: `${p.tempC}°C`, sub: `${toF(p.tempC)}°F`, href: pathFor(p.tempC), current: p.tempC === c, tier: conditionsAt(p.tempC).label }));

const VARIATION_ICONS: Record<string, typeof IconWind> = { race: IconRacingFlag, easy: IconBlip, wind: IconWind, rain: IconRainy, cold: IconSnowFlakes, warm: IconSun };

const crumbs = [
  { name: "kitcheck.cc", url: abs("/") },
  { name: "Kit guide", url: abs("/guide/") },
  { name: label, url: canonical },
];
---

<Base
  title={`What to Wear Cycling at ${label} (${other}) | kitcheck.cc`}
  description={description}
  canonical={canonical}
  schema={[
    articleNode({ url: canonical, headline: h1, description, lang: "en" }),
    breadcrumbNode(crumbs),
    faqNode(faq),
  ]}
>
  <SiteHeader>
    <a href="/" class="btn-primary max-sm:hidden">Use the calculator</a>
  </SiteHeader>

  <PageHero
    eyebrow={`${score.label} conditions`}
    title={`${h1} <span class="text-text-light">(${other})</span>`}
    lead={intro}
    crumbs={[{ name: "kitcheck.cc", href: "/" }, { name: "Kit guide", href: "/guide/" }, { name: label }]}
  >
    <div class="w-full"><AnswerCard text={answer} /></div>
    <Fragment slot="aside">
      <KitCard kitResult={kit} score={score} unit="C" />
      <p class="text-xs text-text-light mt-3 px-1">
        Feels like {label}, moderate pace, light wind (10 km/h, 6 mph), no rain. Same logic as the calculator.
      </p>
    </Fragment>
  </PageHero>

  <!-- VARIATIONS -->
  <section class="bg-white border-y border-border">
    <div class="container py-16 md:py-20">
      <SectionHead
        eyebrow="Adjust"
        title={`When to change your kit at ${label}`}
        lead="Effort, wind, rain and how warm you run all shift the recommendation. Only the parts that change are listed."
      />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {variations.map((v) => {
          const Icon = VARIATION_ICONS[v.key];
          return (
            <div class="bg-bg rounded-2xl border border-border p-5">
              <div class="flex items-center gap-3 mb-4">
                <span class="flex items-center justify-center size-9 rounded-xl bg-white border border-border text-coral shrink-0"><Icon size={17} /></span>
                <div>
                  <h3 class="font-head text-[15px] font-bold text-text leading-tight">{v.title}</h3>
                  <p class="text-xs text-text-light">{v.detail}</p>
                </div>
              </div>
              {v.changes.length ? (
                <dl class="space-y-2.5">
                  {v.changes.map((ch) => (
                    <div>
                      <dt class="font-head text-[10px] font-bold tracking-[0.07em] uppercase text-text-light mb-1">{ZONE_LABELS[ch.zone]}</dt>
                      <dd class="flex flex-wrap gap-1.5">
                        {ch.items.map((it) => it.optional
                          ? <span class="font-head text-[12px] font-medium text-text-light px-2.5 py-1 rounded-lg border border-dashed border-black/15">{it.name} <span class="text-[9px] uppercase opacity-70">opt</span></span>
                          : <span class="font-head text-[12px] font-semibold text-text px-2.5 py-1 rounded-lg bg-white border border-black/5 shadow-[0_1px_2px_rgba(0,0,0,0.05)]">{it.name}</span>)}
                      </dd>
                    </div>
                  ))}
                </dl>
              ) : (
                <p class="text-sm text-text-mid">No change: same kit as above.</p>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <FaqList faq={faq} heading={`Cycling at ${label}: quick answers`} />

  <!-- OTHER TEMPERATURES -->
  <section class="bg-bg border-t border-border">
    <div class="container py-16 md:py-20">
      <SectionHead eyebrow="Other temperatures" title="Colder or warmer?" />
      <nav class="grid grid-cols-4 sm:grid-cols-8 gap-2" aria-label="Other temperatures">
        {siblings.map((s) => (
          <a href={s.href} aria-current={s.current ? "page" : undefined}
            class={`flex flex-col items-center rounded-xl border overflow-hidden transition-colors ${s.current ? "border-coral bg-coral/6" : "border-border bg-white hover:border-text-light"}`}>
            <span class="h-1 w-full" style={`background:${TIER_ACCENT[s.tier]}`}></span>
            <span class={`font-head font-bold text-base sm:text-lg pt-2.5 ${s.current ? "text-coral" : "text-text"}`}>{s.label}</span>
            <span class="text-[11px] text-text-light pb-2.5">{s.sub}</span>
          </a>
        ))}
      </nav>
      <a href="/guide/cycling-temperature-chart/" class="inline-flex mt-5 font-head text-sm font-semibold text-coral hover:opacity-75">Every temperature in the interactive chart →</a>
    </div>
  </section>

  <CtaBand title={`It's never exactly ${label} for the whole ride`} />
  <SiteFooter />
</Base>
