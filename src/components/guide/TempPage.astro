---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../SiteHeader.astro";
import SiteFooter from "../SiteFooter.astro";
import KitCard from "../calculator/KitCard";
import FaqList from "./FaqList.astro";
import PageHero from "../ui/PageHero.astro";
import AnswerCard from "../ui/AnswerCard.astro";
import SectionHead from "../ui/SectionHead.astro";
import CtaBand from "../ui/CtaBand.astro";
import { IconArrowRight } from "@central-icons-react/round-outlined-radius-3-stroke-2";
import { IconRacingFlag, IconBlip, IconWind, IconRainy, IconSnowFlakes, IconSun } from "@central-icons-react/round-outlined-radius-3-stroke-2";
import {
  TEMP_PAGES, ZONE_LABELS, kitAt, conditionsAt, variationsAt,
  toF, pathFor, kitSentence, kitSummary, listJoin, kitChanges,
} from "../../lib/guideData";
import { abs, articleNode, breadcrumbNode, faqNode, CONTENT_PUBLISHED, CONTENT_UPDATED } from "../../lib/site";
import { KIT_ITEM_PAGES, CONDITION_PAGES } from "../../lib/guideContent";
import { itemStatus } from "../../lib/kitRanges";

interface Props { tempC: number; intro: string }
const { tempC: c, intro } = Astro.props;

const label = `${c}°C`;
const other = `${toF(c)}°F`;
const kit = kitAt(c);
const score = conditionsAt(c);
const variations = variationsAt(c);
const canonical = abs(pathFor(c));
// 0–25°C have been live since the first guide release; -5°C came later
const published = [0, 5, 10, 15, 20, 25].includes(c) ? CONTENT_PUBLISHED : CONTENT_UPDATED;

const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
// One headline item per zone keeps descriptions distinct between neighbouring temperatures;
// drop items from the end until it fits Google's ~155-character snippet
const headline = (["torso", "legs", "hands", "feet"] as const)
  .map((z) => kit[z].items.find((i) => !i.optional)?.name)
  .filter((n): n is string => !!n)
  .map(lower);
const describe = (items: string[]) =>
  `What to wear cycling at ${label} (${other}): ${items.join(", ")}. Plus what changes with wind, rain and effort.`;
let items = headline;
while (describe(items).length > 155 && items.length > 2) items = items.slice(0, -1);
const description = describe(items);

const h1 = `What to wear cycling at ${label}`;
const answer = kitSentence(kit);
const at = `At ${label} (${other})`;
// Self-contained answers: each one names the temperature and reads as a full sentence on its own
const wearSentence = (zones: Parameters<typeof kitSummary>[1], none: string) => {
  const { required, optional } = kitSummary(kit, zones);
  const opt = optional.length ? `${required.length ? ", plus" : ""} ${listJoin(optional, "or")} if you like` : "";
  return required.length ? `${at} wear ${lower(listJoin(required))}${opt}.` : `${at} ${none}${opt ? `:${opt}` : ""}.`;
};
const rain = variations.find((v) => v.key === "rain");
const unchanged = variations.filter((v) => !v.changes.length);
const race = variations.find((v) => v.key === "race");
const changeText = (v: typeof rain) =>
  v && v.changes.length
    ? v.changes.map((ch) => `${ZONE_LABELS[ch.zone].toLowerCase()}: ${listJoin(ch.items.map((i) => lower(i.name) + (i.optional ? " (optional)" : "")))}`).join("; ")
    : null;

// Generated from the same logic as the kit card, so the answers can't drift from the calculator
const faq = [
  { q: `What should I wear cycling at ${label} (${other})?`, a: `${at}, at a moderate pace in light wind and no rain, wear: ${lower(answer)}` },
  // US riders search in Fahrenheit: answer that question in their words too
  { q: `What to wear cycling at ${toF(c)} degrees Fahrenheit?`, a: `${toF(c)}°F is ${c}°C. At a moderate pace in light wind (6 mph) and no rain, wear: ${lower(answer)}` },
  { q: `Do I need gloves cycling at ${label}?`, a: wearSentence(["hands"], "you don't need gloves") },
  { q: `Shorts or tights at ${label}?`, a: wearSentence(["legs"], "bib shorts are enough") },
  ...(changeText(rain) ? [{ q: `What changes if it rains at ${label}?`, a: `${at} with rain likely, change this: ${changeText(rain)}.` }] : []),
  ...(changeText(race) ? [{ q: `What if I ride hard at ${label}?`, a: `At race pace or on a fast group ride you warm up a lot more. Change this: ${changeText(race)}.` }] : []),
];

const siblings = TEMP_PAGES.map((p) => ({ label: `${p.tempC}°C`, sub: `${toF(p.tempC)}°F`, href: pathFor(p.tempC), current: p.tempC === c, tier: conditionsAt(p.tempC).label }));

// Neighbouring temperature pages and what changes towards them: unique, useful content per page
const idx = TEMP_PAGES.findIndex((p) => p.tempC === c);
const neighbours = [
  idx > 0 ? { dir: "Colder", tempC: TEMP_PAGES[idx - 1].tempC } : null,
  idx < TEMP_PAGES.length - 1 ? { dir: "Warmer", tempC: TEMP_PAGES[idx + 1].tempC } : null,
].filter((n) => n !== null).map((n) => ({ ...n, changes: kitChanges(kit, kitAt(n.tempC)) }));

// Kit guides for the items in this kit list (contextual internal links)
// plus the season page that fits: winter up to 5°C, summer from 20°C
const season = c <= 5 ? "winter-cycling-clothing" : c >= 20 ? "summer-cycling-clothing" : null;
const relatedGuides = [
  ...KIT_ITEM_PAGES.filter((p) => itemStatus(kit, p.match) || (p.extra && itemStatus(kit, p.extra.match))),
  ...CONDITION_PAGES.filter((p) => p.slug === season),
];

const VARIATION_ICONS: Record<string, typeof IconWind> = { race: IconRacingFlag, easy: IconBlip, wind: IconWind, rain: IconRainy, cold: IconSnowFlakes, warm: IconSun };

const crumbs = [
  { name: "kitcheck.cc", url: abs("/") },
  { name: "Kit guide", url: abs("/guide/") },
  { name: `What to wear at ${label}`, url: canonical },
];
---

<Base
  title={`What to Wear Cycling at ${label} (${other}): Kit List | kitcheck.cc`}
  description={description}
  canonical={canonical}
  article
  published={published}
  schema={[
    articleNode({ url: canonical, headline: h1, description, lang: "en", published }),
    breadcrumbNode(crumbs),
    faqNode(faq),
  ]}
>
  <SiteHeader slot="header">
    <a href="/" class="btn-primary max-sm:hidden">Use the calculator</a>
  </SiteHeader>

  <PageHero
    byline
    eyebrow={`${score.label} conditions`}
    title={`${h1} <span class="text-text-light">(${other})</span>`}
    lead={intro}
    crumbs={[{ name: "kitcheck.cc", href: "/" }, { name: "Kit guide", href: "/guide/" }, { name: label }]}
  >
    <div class="w-full"><AnswerCard text={answer} /></div>
    <Fragment slot="aside">
      <KitCard kitResult={kit} score={score} unit="C" />
      <p class="text-xs text-text-light mt-3 px-1">
        Feels like {label}, moderate pace, light wind (10 km/h, 6 mph), no rain. Same logic as the calculator.
      </p>
      {relatedGuides.length > 0 && (
        <p class="text-[13px] text-text-mid mt-3 px-1">
          More on:{" "}
          {relatedGuides.map((p, i) => (
            <>{i > 0 && " · "}<a href={`/guide/${p.slug}/`} class="text-coral hover:opacity-75">{p.slug === season ? `${p.label.toLowerCase()} cycling clothing` : p.label.toLowerCase()}</a></>
          ))}
        </p>
      )}
    </Fragment>
  </PageHero>

  <!-- VARIATIONS -->
  <section class="bg-bg">
    <div class="container py-16 md:py-20">
      <SectionHead
        eyebrow="Adjust"
        title={`When to change your kit at ${label}`}
        lead="Effort, wind, rain and how warm you run all shift the recommendation. Only the parts that change are listed."
      />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {variations.filter((v) => v.changes.length).map((v) => {
          const Icon = VARIATION_ICONS[v.key];
          return (
            <div class="bg-white rounded-2xl border border-border p-5">
              <div class="flex items-center gap-3 mb-4">
                <span class="flex items-center justify-center size-9 rounded-xl bg-white border border-border text-coral shrink-0"><Icon size={17} /></span>
                <div>
                  <h3 class="font-head text-[15px] font-bold text-text leading-tight">{v.title}</h3>
                  <p class="text-xs text-text-light">{v.detail}</p>
                </div>
              </div>
              {v.changes.length ? (
                <dl class="space-y-2.5">
                  {v.changes.map((ch) => (
                    <div>
                      <dt class="font-head text-[10px] font-bold tracking-[0.07em] uppercase text-text-light mb-1">{ZONE_LABELS[ch.zone]}</dt>
                      <dd class="flex flex-wrap gap-1.5">
                        {ch.items.map((it) => it.optional
                          ? <span class="font-head text-[12px] font-medium text-text-light px-2.5 py-1 rounded-lg border border-dashed border-black/15">{it.name} <span class="text-[9px] uppercase opacity-70">opt</span></span>
                          : <span class="font-head text-[12px] font-semibold text-text px-2.5 py-1 rounded-lg bg-white border border-black/5 shadow-[0_1px_2px_rgba(0,0,0,0.05)]">{it.name}</span>)}
                      </dd>
                    </div>
                  ))}
                </dl>
              ) : (
                <p class="text-sm text-text-mid">No change: same kit as above.</p>
              )}
            </div>
          );
        })}
      </div>
      {unchanged.length > 0 && (
        <p class="text-sm text-text-mid mt-5">
          No change at {label} for: {listJoin(unchanged.map((v) => lower(v.title)))}.
        </p>
      )}
    </div>
  </section>

  <FaqList faq={faq} heading={`Cycling at ${label}: quick answers`} lead={`What riders ask about kit at ${label} (${other}), from gloves to rain.`} />

  <!-- OTHER TEMPERATURES -->
  <section class="bg-bg border-t border-border">
    <div class="container py-16 md:py-20">
      <SectionHead eyebrow="Other temperatures" title="Colder or warmer?" lead={`What changes compared with ${label}, at the same moderate pace.`} />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-8">
        {neighbours.map((n) => (
          <a href={pathFor(n.tempC)} class="group bg-white rounded-2xl border border-border p-5 hover:border-text-light transition-colors">
            <p class="font-head text-[11px] font-semibold tracking-[0.08em] uppercase text-text-light">{n.dir}</p>
            <h3 class="font-head font-bold text-lg text-text mt-1 mb-3">What to wear at {n.tempC}°C <span class="text-text-light font-semibold">({toF(n.tempC)}°F)</span></h3>
            <dl class="space-y-1.5 text-sm">
              {n.changes.map((ch) => (
                <div class="flex gap-2">
                  <dt class="text-text-light shrink-0 w-24">{ZONE_LABELS[ch.zone]}</dt>
                  <dd class="text-text-mid">{listJoin(ch.items.map((i, n) => (n ? lower(i.name) : i.name) + (i.optional ? " (optional)" : "")))}</dd>
                </div>
              ))}
            </dl>
            <span class="inline-flex items-center gap-1 font-head text-[13px] font-semibold text-coral mt-4 group-hover:opacity-75">Full kit list <IconArrowRight size={14} /></span>
          </a>
        ))}
      </div>
      <nav class="grid grid-cols-4 sm:grid-cols-7 gap-2" aria-label="Other temperatures">
        {siblings.map((s) => (
          <a href={s.href} aria-current={s.current ? "page" : undefined}
            class={`flex flex-col items-center rounded-xl border overflow-hidden transition-colors ${s.current ? "border-coral bg-coral/6" : "border-border bg-white hover:border-text-light"}`}>
            <span class={`font-head font-bold text-base sm:text-lg pt-2.5 ${s.current ? "text-coral" : "text-text"}`}>{s.label}</span>
            <span class="text-[11px] text-text-light pb-2.5">{s.sub}</span>
          </a>
        ))}
      </nav>
      <a href="/guide/cycling-temperature-chart/" class="inline-flex items-center gap-1 mt-5 font-head text-sm font-semibold text-coral hover:opacity-75">Every temperature in the interactive chart <IconArrowRight size={15} /></a>
    </div>
  </section>

  <CtaBand title={`It's never exactly ${label} for the whole ride`} />
  <SiteFooter slot="footer" />
</Base>
