---
/**
 * FAQ: collapsed, first question open. Search engines and AI tools read collapsed answers
 * too; pages add the same questions as FAQPage structured data.
 */
import type { Faq } from "../../lib/guideContent";
interface Props { faq: Faq[]; heading?: string }
const { faq, heading = "Frequently asked questions" } = Astro.props;
---

<section class="bg-bg border-t border-border">
  <div class="container py-16 md:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-8 lg:gap-14">
      <div class="lg:sticky lg:top-[96px] self-start">
        <p class="font-head text-[11px] font-semibold tracking-[0.08em] uppercase text-coral mb-3">FAQ</p>
        <h2 class="font-head font-bold text-2xl md:text-[2rem] tracking-tight leading-tight text-text text-balance">{heading}</h2>
      </div>
      <div class="flex flex-col gap-2.5">
        {faq.map((f, i) => (
          <details class="group bg-white rounded-2xl border border-border open:shadow-[0_8px_24px_-12px_rgba(0,0,0,0.12)] transition-shadow" open={i === 0}>
            <summary class="faq-summary flex items-center justify-between gap-4 cursor-pointer px-5 py-4 sm:px-6 sm:py-5">
              <h3 class="font-head font-semibold text-[15px] sm:text-base text-text">{f.q}</h3>
              <span class="flex items-center justify-center size-7 rounded-full bg-bg-card text-text-mid shrink-0 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
                <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
              </span>
            </summary>
            <p class="px-5 pb-5 sm:px-6 sm:pb-6 -mt-1 text-[15px] text-text-mid leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .faq-summary { list-style: none; }
  .faq-summary::-webkit-details-marker { display: none; }
</style>
