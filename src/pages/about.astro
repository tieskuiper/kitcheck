---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Breadcrumb from "../components/guide/Breadcrumb.astro";
import { abs, breadcrumbNode, AUTHOR } from "../lib/site";

const canonical = abs("/about/");
const description = "kitcheck.cc is a free cycling kit calculator made by a road cyclist in the Netherlands and tested by Raas Racing Team. Who makes it, why, and where the data comes from.";
---

<Base
  title="About kitcheck.cc | Free Cycling Kit Calculator"
  description={description}
  canonical={canonical}
  schema={[
    {
      "@type": "AboutPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: "About kitcheck.cc",
      description,
      about: { "@id": "https://kitcheck.cc/#organization" },
      author: { "@id": "https://kitcheck.cc/#author" },
    },
    breadcrumbNode([{ name: "kitcheck.cc", url: abs("/") }, { name: "About", url: canonical }]),
  ]}
>
  <SiteHeader>
    <a href="/" class="btn-primary">Use the calculator</a>
  </SiteHeader>

  <section class="bg-bg">
    <div class="container">
      <div class="max-w-2xl pt-16 md:pt-18 lg:pt-20 pb-10 md:pb-12">
        <Breadcrumb items={[{ name: "kitcheck.cc", href: "/" }, { name: "About" }]} />
        <h1 class="font-head text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.1] text-text mb-4">About kitcheck.cc</h1>
        <p class="text-text-mid leading-relaxed">
          kitcheck.cc answers one question every road cyclist asks before a ride: what do I wear today?
        </p>
      </div>
    </div>
  </section>

  <section class="bg-bg border-t border-border">
    <div class="container py-12 md:py-16">
      <div class="max-w-2xl prose-custom">
        <h2>Who makes it</h2>
        <p>
          kitcheck.cc is a free, personal project by {AUTHOR.name}, a road cyclist in the Netherlands.
          There is no company or shop behind it, and the kit advice doesn't recommend brands.
        </p>

        <h2>Tested on the road</h2>
        <p>
          <a href="https://www.instagram.com/raasracingteam/" rel="noopener">Raas Racing Team</a>, an amateur road
          team, checks kitcheck.cc before every ride. The logic is shaped by real rides, like the
          rule that gloves and overshoes are chosen for the whole ride, because nobody carries a
          second pair.
        </p>

        <h2>How it works</h2>
        <p>
          The calculator combines the hourly forecast for your ride with your effort level and how
          warm you naturally run. <a href="/how-it-works/">How it works</a> explains every step,
          and the <a href="/guide/">kit guide</a> and <a href="/guide/cycling-temperature-chart/">temperature chart</a>
          use exactly the same logic.
        </p>

        <h2>Data sources</h2>
        <ul>
          <li>Weather forecast and place search: <a href="https://open-meteo.com" rel="noopener">Open-Meteo</a></li>
          <li>Place names for your location: <a href="https://nominatim.org" rel="noopener">Nominatim</a> (OpenStreetMap)</li>
          <li>Maps: <a href="https://openfreemap.org" rel="noopener">OpenFreeMap</a> and OpenStreetMap</li>
        </ul>

        <h2>Free and private</h2>
        <p>
          No account, no newsletter, no ads. GPX files never leave your browser, and analytics only
          run if you accept them. The details are in the <a href="/privacy/">privacy policy</a>.
          Questions or feedback: <a href="mailto:privacy@kitcheck.cc">privacy@kitcheck.cc</a>.
        </p>
      </div>
    </div>
  </section>

  <SiteFooter />
</Base>
