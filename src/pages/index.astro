---
import Base from "../layouts/Base.astro";
import Calculator from "../components/Calculator";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

---

<Base>

  <!-- HEADER -->
  <SiteHeader>
    <button id="header-geolocate" class="btn-primary">
      📍
      <span class="hidden sm:inline">Use current location</span>
    </button>
  </SiteHeader>

  <!-- INTRO -->
  <section class="bg-bg">
    <div class="container">
      <div class="max-w-2xl mx-auto text-center pt-16 md:pt-18 lg:pt-20">
        <h1
          class="font-head text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.1] text-text mb-4"
        >
          Know exactly <span class="text-coral">what to wear</span> before you ride.
        </h1>
        <p class="text-text-mid leading-[1.75] max-w-sm mx-auto font-light">
          Search your city, set your effort level and get a full kit list in seconds.
        </p>
      </div>
    </div>
  </section>

  <!-- CALCULATOR -->
  <Calculator client:load />

  <!-- GUIDE TEASER -->
  <section class="border-t border-border bg-bg-card">
    <div class="container py-10">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <p class="font-head font-semibold text-text mb-1">Not sure where to start?</p>
          <p class="text-sm text-text-mid">The guide covers what to wear at every temperature, from a winter freeze to a hot summer day, with notes on rain, wind and how hard you're riding.</p>
        </div>
        <a
          href="/guide"
          class="shrink-0 inline-flex items-center gap-2 py-2.5 px-4 bg-text text-bg rounded-lg font-head text-sm font-semibold hover:opacity-85 transition-opacity"
        >
          Read the guide
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <SiteFooter />

  <script>
    document
      .getElementById("header-geolocate")!
      .addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("kitcheck:geolocate"));
      });
  </script>
</Base>
