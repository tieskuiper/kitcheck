---
import Base from "../layouts/Base.astro";
import Calculator from "../components/Calculator";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Base>
  <!-- HEADER -->
  <SiteHeader>
    <div
      class="flex rounded-lg border border-border overflow-hidden"
      style="font-family:var(--font-head); font-size:13px; font-weight:600; line-height:1"
    >
      <button
        id="unit-c"
        class="px-3 py-[9px] border-none cursor-pointer"
        style="background:#FF5130; color:#ffffff; transition:background 0.15s,color 0.15s"
        >°C</button
      >
      <button
        id="unit-f"
        class="px-3 py-[9px] border-none cursor-pointer"
        style="background:transparent; color:#6B6A67; transition:background 0.15s,color 0.15s"
        >°F</button
      >
    </div>
  </SiteHeader>

  <!-- INTRO -->
  <section class="bg-bg">
    <div class="container">
      <div class="max-w-2xl mx-auto text-center pt-16 md:pt-18 lg:pt-20">
        <h1
          class="font-head text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.1] text-text mb-4"
        >
          Know exactly <span class="text-coral">what to wear</span> before you ride.
        </h1>
        <p class="text-text-mid leading-[1.75] max-w-sm mx-auto font-light">
          Search your city, set your effort level and get a full kit list in
          seconds.
        </p>
      </div>
    </div>
  </section>

  <!-- CALCULATOR -->
  <Calculator client:load />

  <!-- GUIDE TEASER -->
  <section class="border-t border-border bg-bg-card">
    <div class="container py-10">
      <div
        class="flex flex-col sm:flex-row sm:items-center justify-between gap-4"
      >
        <div>
          <p class="font-head font-semibold text-text mb-1">
            Not sure where to start?
          </p>
          <p class="text-sm text-text-mid">
            The guide covers what to wear at every temperature, from a winter
            freeze to a hot summer day, with notes on rain, wind and how hard
            you're riding.
          </p>
        </div>
        <a href="/guide" class="btn-secondary">Read the guide</a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <SiteFooter />

  <script>
    const btnC = document.getElementById("unit-c") as HTMLButtonElement;
    const btnF = document.getElementById("unit-f") as HTMLButtonElement;

    function setUnit(unit: "C" | "F") {
      btnC.style.background = unit === "C" ? "#FF5130" : "transparent";
      btnC.style.color = unit === "C" ? "#ffffff" : "#6B6A67";
      btnF.style.background = unit === "F" ? "#FF5130" : "transparent";
      btnF.style.color = unit === "F" ? "#ffffff" : "#6B6A67";
      window.dispatchEvent(
        new CustomEvent("kitcheck:unit", { detail: { unit } }),
      );
    }

    btnC.addEventListener("click", () => setUnit("C"));
    btnF.addEventListener("click", () => setUnit("F"));
  </script>
</Base>
