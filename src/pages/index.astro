---
import Base from "../layouts/Base.astro";
import Calculator from "../components/calculator/Calculator";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TeamBanner from "../components/TeamBanner.astro";
import { TEMP_PAGES, toF, pathFor, kitAt, kitSentence, conditionsAt } from "../lib/guideData";
import SectionHead from "../components/ui/SectionHead.astro";
import { TIER_ACCENT } from "../components/calculator/constants";
import { IconRainy } from "@central-icons-react/round-outlined-radius-3-stroke-2";
import RouteProfile from "../components/brand/RouteProfile.astro";
import ThermoBar from "../components/brand/ThermoBar.astro";
import MiniRange from "../components/brand/MiniRange.astro";
import { itemRanges } from "../lib/kitRanges";

const armWarmers = itemRanges((n) => n === "Arm warmers", { intensity: "moderate" });

// Quick reference for the homepage: the answer people (and AI tools) look for, in plain text
const QUICK_TEMPS = [0, 5, 10, 15, 20, 25];
---

<Base
  title="Cycling Kit Calculator: What to Wear for Your Ride Today | kitcheck.cc"
  description="Free cycling kit calculator. Get a kit list for your ride based on the real forecast (temperature, wind and rain) and how hard you're riding."
  canonical="https://kitcheck.cc/"
  appSchema
>
  <!-- HEADER -->
  <SiteHeader>
    <div
      class="flex rounded-lg border border-border overflow-hidden"
      style="font-family:var(--font-head); font-size:13px; font-weight:600; line-height:1"
    >
      <button
        id="unit-c"
        class="px-3 py-[9px] border-none cursor-pointer"
        style="background:#FF5130; color:#ffffff; transition:background 0.15s,color 0.15s"
        >°C</button
      >
      <button
        id="unit-f"
        class="px-3 py-[9px] border-none cursor-pointer"
        style="background:transparent; color:#6B6A67; transition:background 0.15s,color 0.15s"
        >°F</button
      >
    </div>
  </SiteHeader>

  <!-- INTRO -->
  <section class="relative overflow-hidden bg-bg">
    <RouteProfile variant="hero" class="absolute inset-x-0 bottom-0 h-28 md:h-36 opacity-70" />
    <div class="container relative">
      <div class="max-w-2xl mx-auto text-center pt-12 md:pt-16 lg:pt-18 pb-14 md:pb-20">
        <p class="road-label justify-center mb-5">Free · °C and °F · No account</p>
        <h1 class="font-head text-[2.25rem] md:text-5xl lg:text-[3.75rem] font-bold tracking-[-0.035em] leading-[1.02] text-text text-balance mb-5">
          <span class="text-coral">What to wear cycling</span>, sorted before you ride.
        </h1>
        <p class="text-lg text-text-mid leading-relaxed max-w-md mx-auto">
          Search your city, set your effort level and get a full kit list in seconds.
        </p>
      </div>
    </div>
  </section>

  <!-- CALCULATOR -->
  <section class="bg-bg">
    <Calculator client:load />
  </section>

  <!-- TEAM -->
  <TeamBanner />

  <!-- HOW IT WORKS -->
  <section class="border-t border-border bg-white">
    <div class="container py-16 md:py-24">
      <SectionHead
        align="center"
        eyebrow="How it works"
        title="The forecast for your ride, turned into a kit list"
        lead="Most cyclists either overdress or underdress. kitcheck.cc is a free cycling clothing calculator that tells you what to wear, based on the real forecast and how hard you plan to push."
      />
      <ol class="relative grid grid-cols-1 md:grid-cols-3 gap-3">
        {[
          { km: "km 0", title: "Live weather for your whole ride", text: "Feels-like temperature, wind and rain chance for every hour you're out, anywhere in the world. Upload a GPX and it follows your route." },
          { km: "km 40", title: "Adjusted for your effort", text: "Riding hard feels several degrees warmer than an easy spin. Pick your intensity and how warm you run, and the kit follows." },
          { km: "Finish", title: "Every layer covered", text: "Head, upper body, hands, legs and feet, with required and optional items, and notes when conditions change during your ride." },
        ].map((f, i) => (
          <li class="relative bg-bg rounded-[6px] border border-black/10 p-6 pt-5">
            <span class="inline-flex items-center gap-2 font-head text-[11px] font-bold tracking-[0.1em] uppercase text-text-light mb-6">
              <span class:list={["size-3 rounded-full border-2", i === 2 ? "border-coral bg-coral" : "border-coral bg-white"]}></span>{f.km}
            </span>
            <h3 class="font-head font-bold text-lg text-text mb-2">{f.title}</h3>
            <p class="text-[15px] text-text-mid leading-relaxed">{f.text}</p>
          </li>
        ))}
      </ol>
      <div class="flex justify-center mt-8">
        <a href="/how-it-works/" class="font-head text-sm font-semibold text-coral hover:opacity-75">The method, step by step →</a>
      </div>
    </div>
  </section>

  <!-- QUICK REFERENCE -->
  <section class="border-t border-border bg-bg">
    <div class="container py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] gap-8 lg:gap-14 items-start">
        <div class="lg:sticky lg:top-[96px]">
          <SectionHead
            eyebrow="Quick reference"
            title="What to wear cycling by temperature"
            lead="The short version, at a moderate pace in light wind and no rain. Your ride is never exactly one temperature, which is what the calculator above is for."
          />
          <a href="/guide/cycling-temperature-chart/" class="btn-primary py-3! px-5! text-[14px]! -mt-2">Open the interactive chart</a>
        </div>
        <dl class="bg-white rounded-[6px] border border-black/10 divide-y divide-dashed divide-black/15 overflow-hidden">
          {QUICK_TEMPS.map((c) => {
            const tier = conditionsAt(c).label;
            return (
              <div class="grid grid-cols-[84px_1fr] sm:grid-cols-[110px_1fr] gap-3 px-4 sm:px-6 py-4 relative">
                <span class="absolute left-0 inset-y-0 w-1" style={`background:${TIER_ACCENT[tier]}`} aria-hidden="true"></span>
                <dt>
                  <a href={pathFor(c)} class="font-head font-bold text-lg text-text hover:text-coral transition-colors">{c}°C</a>
                  <span class="block text-xs text-text-light">{toF(c)}°F</span>
                </dt>
                <dd class="text-sm text-text-mid leading-relaxed">{kitSentence(kitAt(c))}</dd>
              </div>
            );
          })}
        </dl>
      </div>
    </div>
  </section>

  <!-- GUIDE -->
  <section class="border-t border-border bg-white">
    <div class="container py-16 md:py-24">
      <SectionHead align="center" eyebrow="Kit guide" title="Not sure what kit you need?" lead="Answers for every temperature, every piece of kit and every kind of weather." />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <a href="/guide/cycling-temperature-chart/" class="group flex flex-col bg-bg rounded-[6px] border border-black/10 p-6 hover:border-coral/60 transition-colors">
          <span class="road-label">Interactive</span>
          <span class="font-head font-bold text-xl text-text mt-4">Temperature chart</span>
          <span class="text-[15px] text-text-mid leading-relaxed mt-1.5 flex-1">Slide to any temperature from -10°C to 35°C (14–95°F) and see what to wear.</span>
          <ThermoBar class="h-2 rounded-full mt-6" />
          <span class="flex justify-between mt-1 font-head text-[10px] font-semibold text-text-light"><span>-10°</span><span>35°</span></span>
        </a>
        <a href="/guide/" class="group flex flex-col bg-bg rounded-[6px] border border-black/10 p-6 hover:border-coral/60 transition-colors">
          <span class="road-label">Kit</span>
          <span class="font-head font-bold text-xl text-text mt-4">When to wear what</span>
          <span class="text-[15px] text-text-mid leading-relaxed mt-1.5 flex-1">Arm warmers, overshoes, bib tights and more: the temperature where each comes in. Arm warmers, for example:</span>
          <span class="block mt-5"><MiniRange ranges={armWarmers} /></span>
        </a>
        <a href="/guide/what-to-wear-cycling-in-the-rain/" class="group relative overflow-hidden flex flex-col bg-bg rounded-[6px] border border-black/10 p-6 hover:border-coral/60 transition-colors">
          <IconRainy size={110} className="absolute -right-6 -top-6 text-coral/10" />
          <span class="road-label">Weather</span>
          <span class="font-head font-bold text-xl text-text mt-4">Rain, wind and winter</span>
          <span class="text-[15px] text-text-mid leading-relaxed mt-1.5 flex-1">What changes when the weather does, and how to stay warm and dry.</span>
          <span class="font-head font-bold text-[2rem] tracking-tight text-text leading-none mt-5">60%</span>
          <span class="text-xs text-text-light mt-1">rain chance: full rain kit, scaled to the temperature</span>
        </a>
      </div>
      <nav class="flex flex-wrap justify-center gap-2 mt-8" aria-label="Kit by temperature">
        {TEMP_PAGES.map(({ tempC }) => (
          <a href={pathFor(tempC)} class="px-3 py-1.5 rounded-lg border border-border bg-white font-head text-[13px] font-semibold text-text-mid hover:border-text-light hover:text-text transition-colors">
            {tempC}°C <span class="text-text-light">{toF(tempC)}°F</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- FOOTER -->
  <SiteFooter />

  <script>
    import { preferredUnit } from "../lib/units";
    const btnC = document.getElementById("unit-c") as HTMLButtonElement;
    const btnF = document.getElementById("unit-f") as HTMLButtonElement;

    function paint(unit: "C" | "F") {
      btnC.style.background = unit === "C" ? "#FF5130" : "transparent";
      btnC.style.color = unit === "C" ? "#ffffff" : "#6B6A67";
      btnF.style.background = unit === "F" ? "#FF5130" : "transparent";
      btnF.style.color = unit === "F" ? "#ffffff" : "#6B6A67";
    }

    function setUnit(unit: "C" | "F") {
      paint(unit);
      window.dispatchEvent(
        new CustomEvent("kitcheck:unit", { detail: { unit } }),
      );
    }

    // Same starting unit as the calculator: saved choice, else °F only in a US timezone
    paint(preferredUnit());

    btnC.addEventListener("click", () => setUnit("C"));
    btnF.addEventListener("click", () => setUnit("F"));
  </script>
</Base>
