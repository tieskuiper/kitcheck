---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PageHero from "../../components/ui/PageHero.astro";
import SectionHead from "../../components/ui/SectionHead.astro";
import CtaBand from "../../components/ui/CtaBand.astro";
import FaqList from "../../components/guide/FaqList.astro";
import { TEMP_PAGES, kitAt, conditionsAt, toF, pathFor } from "../../lib/guideData";
import { KIT_ITEM_PAGES, CONDITION_PAGES } from "../../lib/guideContent";
import { itemRanges, rangePhrase } from "../../lib/kitRanges";
import { abs, breadcrumbNode, faqNode } from "../../lib/site";
import { TIER_ACCENT, TIER_BG, CAT_ICONS } from "../../components/calculator/constants";
import { IconRainy, IconWind, IconSnowFlakes, IconSun, IconArrowRight } from "@central-icons-react/round-outlined-radius-3-stroke-2";

// One headline per temperature: the upper body and legs items say most
const temps = TEMP_PAGES.map(({ tempC }) => {
  const kit = kitAt(tempC);
  const pick = (z: "torso" | "legs") => kit[z].items.filter((i) => !i.optional).map((i) => i.name);
  return { tempC, label: conditionsAt(tempC).label, headline: [...pick("torso").slice(0, 1), ...pick("legs")].join(" + ") };
});

const items = KIT_ITEM_PAGES.map((p) => {
  const r = itemRanges(p.match, { ...p.overrides, intensity: "moderate" });
  return { ...p, range: r.required ?? r.optional, optionalOnly: !r.required };
});

const CONDITION_ICONS = { rain: IconRainy, wind: IconWind, snow: IconSnowFlakes, sun: IconSun };

const faq = [
  {
    q: "When do I need a cycling gilet?",
    a: "A gilet is ideal between 10–16°C with wind, or on routes with long descents. It keeps your core warm without overheating on climbs, and packs into a jersey pocket easily. In rain, swap it for a waterproof jacket instead.",
  },
  {
    q: "What cycling kit do I need for riding in rain?",
    a: "It depends on the temperature. Below about 15°C you want a proper waterproof jacket, and below 10°C waterproof gloves and overshoes too, because cold and wet hands and feet go numb fast. In mild rain a packable jacket is enough, with thin rain overshoes if you want dry shoes. Above about 22°C many riders skip the jacket altogether. kitcheck.cc reads the rain chance from the forecast and scales the rain kit to the temperature.",
  },
  {
    q: "Does ride intensity affect what cycling kit I need?",
    a: "Yes — a hard effort can feel 5–8°C warmer than an easy ride, so you need fewer layers on your body. Your hands and feet don't warm up nearly as much, though: even when racing in the cold you still want proper gloves and overshoes. kitcheck.cc adjusts the body layers fully for your effort level and the gloves and overshoes only partly.",
  },
  {
    q: "Should I wear bib shorts or bib tights?",
    a: "Bib tights below about 8°C, then bib shorts with leg warmers from 8–11°C, and bib shorts with knee warmers for the 11–14°C range. Above 14°C bib shorts alone are usually fine, with knee warmers optional if it feels fresh. Wind and rain both push those thresholds up. kitcheck.cc picks the right option based on your actual conditions.",
  },
];
---

<Base
  title="What to Wear Cycling by Temperature (°C and °F) | kitcheck.cc"
  description="What to wear cycling at every temperature, from -5°C (23°F) to 25°C (77°F). Kit lists per temperature, an interactive chart, and kit for rain, wind and winter."
  canonical="https://kitcheck.cc/guide/"
  schema={[
    {
      "@type": "CollectionPage",
      "@id": `${abs("/guide/")}#page`,
      url: abs("/guide/"),
      name: "What to wear cycling at any temperature",
      isPartOf: { "@id": `${abs("/")}#website` },
      mainEntity: {
        "@type": "ItemList",
        itemListElement: [
          { url: abs("/guide/cycling-temperature-chart/"), name: "Cycling clothing temperature chart" },
          ...TEMP_PAGES.map((p) => ({ url: abs(pathFor(p.tempC)), name: `What to wear cycling at ${p.tempC}°C (${toF(p.tempC)}°F)` })),
          ...KIT_ITEM_PAGES.map((p) => ({ url: abs(`/guide/${p.slug}/`), name: p.title })),
          ...CONDITION_PAGES.map((p) => ({ url: abs(`/guide/${p.slug}/`), name: p.title })),
        ].map((it, i) => ({ "@type": "ListItem", position: i + 1, ...it })),
      },
    },
    faqNode(faq),
    breadcrumbNode([
      { name: "kitcheck.cc", url: abs("/") },
      { name: "Cycling Kit Guide", url: abs("/guide/") },
    ]),
  ]}
>
  <SiteHeader>
    <a href="/" class="btn-primary max-sm:hidden">Use the calculator</a>
  </SiteHeader>

  <PageHero
    align="center"
    eyebrow="Kit guide"
    title="What to wear cycling, <span class='text-coral'>at any temperature</span>"
    lead="What to wear at each temperature, when each piece of kit comes in, and what changes with rain, wind and cold."
    crumbs={[{ name: "kitcheck.cc", href: "/" }, { name: "Kit guide" }]}
  >
    <a href="/guide/cycling-temperature-chart/" class="btn-primary py-3! px-5! text-[14px]!">Open the temperature chart</a>
    <a href="/" class="btn-secondary-outline py-3! px-5! text-[14px]!">Use the calculator</a>
  </PageHero>

  <!-- BY TEMPERATURE: a scale from cold to hot -->
  <section class="bg-bg">
    <div class="container pb-16 md:pb-24">
      <SectionHead eyebrow="By temperature" title="Pick your temperature" lead="Feels-like temperature, moderate pace, light wind and no rain." />
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2.5">
        {temps.map((t) => (
          <a href={pathFor(t.tempC)} class="group relative flex flex-col bg-white rounded-2xl border border-border overflow-hidden hover:-translate-y-0.5 hover:shadow-[0_12px_28px_-12px_rgba(0,0,0,0.18)] transition-all">
            <span class="flex flex-col flex-1 p-4">
              <span class="font-head font-bold text-[1.75rem] tracking-tight text-text leading-none">{t.tempC}°C</span>
              <span class="text-xs text-text-light mt-1">{toF(t.tempC)}°F</span>
              <span class="inline-flex w-fit font-head text-[10px] font-bold tracking-[0.07em] uppercase rounded-full px-2 py-0.5 mt-3" style={`color:${TIER_ACCENT[t.label]};background:${TIER_BG[t.label]}`}>{t.label}</span>
              <span class="text-[13px] text-text-mid leading-snug mt-3 flex-1">{t.headline}</span>
              <span class="inline-flex items-center gap-1 font-head text-[12px] font-semibold text-coral mt-3 group-hover:translate-x-0.5 transition-transform">Full kit <IconArrowRight size={13} /></span>
            </span>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- KIT ITEMS -->
  <section class="bg-white border-y border-border">
    <div class="container py-16 md:py-24">
      <SectionHead eyebrow="By piece of kit" title="When to wear what" lead="The temperature where each piece of kit comes in, at a moderate pace. Every page shows the range per effort level." />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        {items.map((p) => {
          const Icon = CAT_ICONS[p.zone];
          return (
            <a href={`/guide/${p.slug}/`} class="group flex items-start gap-3.5 bg-bg rounded-2xl border border-border p-4 hover:border-text-light transition-colors">
              <span class="flex items-center justify-center size-10 rounded-xl bg-white border border-border text-coral shrink-0"><Icon size={18} /></span>
              <span class="min-w-0">
                <span class="block font-head font-bold text-[15px] text-text">{p.label}</span>
                <span class="block text-[13px] text-text-mid mt-0.5">
                  {p.range ? <>{p.optionalOnly ? "Optional at " : ""}{rangePhrase(p.range)}</> : "Depends on conditions"}
                  {p.condition && <span class="text-text-light"> {p.condition.replace(/ \(.*\)$/, "")}</span>}
                </span>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CONDITIONS -->
  <section class="bg-bg">
    <div class="container py-16 md:py-24">
      <SectionHead eyebrow="By weather" title="Rain, wind and winter" lead="What changes when the weather does." />
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {CONDITION_PAGES.map((p) => {
          const Icon = CONDITION_ICONS[p.icon];
          return (
            <a href={`/guide/${p.slug}/`} class="group flex flex-col bg-white rounded-2xl border border-border p-5 hover:-translate-y-0.5 hover:shadow-[0_12px_28px_-12px_rgba(0,0,0,0.18)] transition-all">
              <span class="flex items-center justify-center size-11 rounded-xl bg-coral/10 text-coral mb-5"><Icon size={22} /></span>
              <span class="font-head font-bold text-lg text-text">{p.label}</span>
              <span class="text-sm text-text-mid leading-relaxed mt-1.5 flex-1">{p.teaser}</span>
              <span class="inline-flex items-center gap-1 font-head text-[13px] font-semibold text-coral mt-4">Read the guide <IconArrowRight size={14} /></span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <FaqList faq={faq} />
  <CtaBand />
  <SiteFooter />
</Base>
