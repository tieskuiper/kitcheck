---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { TEMP_PAGES, kitAt, conditionsAt, keyItems, toF, pathFor } from "../../lib/guideData";
import { TIER_ACCENT } from "../../components/calculator/constants";

const temps = TEMP_PAGES.map(({ tempC }) => {
  const kit = kitAt(tempC);
  return { tempC, tempF: toF(tempC), label: conditionsAt(tempC).label, items: keyItems(kit) };
});

const faqSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "When do I need a cycling gilet?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A gilet is ideal between 10–16°C with wind, or on routes with long descents. It keeps your core warm without overheating on climbs, and packs into a jersey pocket easily. In rain, swap it for a waterproof jacket instead.",
          },
        },
        {
          "@type": "Question",
          name: "What cycling kit do I need for riding in rain?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For rain you need a waterproof cycling jacket (not just water-resistant), waterproof gloves, and overshoes to keep your feet dry. A cap with a peak under your helmet keeps rain off your face. kitcheck.cc detects high precipitation probability and adds a waterproof layer to the recommendation automatically.",
          },
        },
        {
          "@type": "Question",
          name: "Does ride intensity affect what cycling kit I need?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes — intensity is one of the biggest variables. A hard race effort can generate as much warmth as a 5–8°C temperature increase compared to an easy ride. kitcheck.cc lets you select your effort level (easy, moderate, hard, race) and adjusts the kit recommendation accordingly, so you don't overheat or underdress.",
          },
        },
        {
          "@type": "Question",
          name: "Should I wear bib shorts or bib tights?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Bib tights below about 8°C, then bib shorts with leg warmers from 8–11°C, and bib shorts with knee warmers for the 11–14°C range. Above 14°C bib shorts alone are usually fine, with knee warmers optional if it feels fresh. Wind and rain both push those thresholds up. kitcheck.cc picks the right option based on your actual conditions.",
          },
        },
      ],
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "kitcheck.cc",
          item: "https://kitcheck.cc",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Cycling Kit Guide",
          item: "https://kitcheck.cc/guide/",
        },
      ],
    },
  ],
};
---

<Base
  title="What to Wear Cycling by Temperature (°C and °F) | kitcheck.cc"
  description="What to wear cycling at every temperature, from 0°C (32°F) to 25°C (77°F). Kit lists per temperature, plus how effort, wind and rain change what you need."
  canonical="https://kitcheck.cc/guide/"
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    />
  </Fragment>

  <!-- HEADER -->
  <SiteHeader>
    <a href="/" class="btn-primary">
      <svg
        class="size-4 -mx-1 sm:hidden"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
      >
        <path
          d="M10 6L4 12L10 18"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path><path
          d="M5 12H20"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="max-sm:hidden">Use the calculator</span>
    </a>
  </SiteHeader>

  <!-- PAGE INTRO -->
  <section class="bg-bg">
    <div class="container">
      <div class="max-w-2xl pt-16 md:pt-18 lg:pt-20 pb-12 md:pb-14">
        <nav class="flex items-center gap-2 text-xs text-text-light mb-5">
          <a href="/" class="hover:text-text-mid transition-colors"
            >kitcheck.cc</a
          >
          <span>›</span>
          <span class="text-text-mid">Kit guide</span>
        </nav>
        <h1
          class="font-head text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.1] text-text mb-4"
        >
          Cycling kit by temperature
        </h1>
        <p class="text-text-mid leading-relaxed max-w-xl">
          Temperature matters most, but your effort level, the wind and whether
          it's raining all make a real difference. Browse the guide below or use <a
            href="/"
            class="text-coral hover:opacity-75 transition-opacity"
            >kitcheck.cc</a
          > to get a recommendation based on the actual forecast.
        </p>
      </div>
    </div>
  </section>

  <!-- TEMPERATURE GUIDE -->
  <section class="bg-bg border-t border-border">
    <div class="container py-16 md:py-20">
      <h2 class="font-head font-bold text-xl md:text-2xl text-text mb-2">
        What to wear cycling at every temperature
      </h2>
      <p class="text-text-mid leading-relaxed mb-6 max-w-2xl">
        The kit for each feels-like temperature at a moderate pace, light wind and no rain.
        Open a temperature to see what changes with effort, wind, rain and how warm you run.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-14">
        {
          temps.map((t) => (
            <a
              href={pathFor(t.tempC)}
              class="group bg-white rounded-2xl border border-border p-[22px] hover:border-text-light transition-colors"
            >
              <div class="flex items-center gap-2 mb-1">
                <span class="inline-block w-2.5 h-2.5 rounded-full" style={`background:${TIER_ACCENT[t.label] ?? "#FF5130"}`} />
                <h3 class="font-head font-bold text-base text-text">
                  What to wear at {t.tempC}°C <span class="text-text-light font-semibold">({t.tempF}°F)</span>
                </h3>
              </div>
              <p class="font-head text-[11px] font-semibold tracking-[0.08em] uppercase text-text-mid mb-3 ml-[18px]">
                {t.label}
              </p>
              <ul class="space-y-1.5 text-sm text-text-mid mb-4">
                {t.items.map((item) => <li>{item}</li>)}
              </ul>
              <span class="font-head text-[13px] font-semibold text-coral group-hover:opacity-75 transition-opacity">
                Full kit + what changes →
              </span>
            </a>
          ))
        }
      </div>

      <!-- Other factors -->
      <h2 class="font-head font-bold text-xl text-text mb-5">
        Other factors that shift the recommendation
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <div class="bg-white rounded-2xl border border-border p-[22px]">
          <h3 class="font-head text-[14px] font-bold text-text mb-3">
            Ride intensity
          </h3>
          <p class="text-sm text-text-mid leading-relaxed">
            The harder you ride, the warmer you get. A race-pace effort can
            easily mean one or two fewer layers than on a steady endurance spin.
            Set your intensity in the calculator and it adjusts the
            recommendation for you.
          </p>
        </div>

        <div class="bg-white rounded-2xl border border-border p-[22px]">
          <h3 class="font-head text-[14px] font-bold text-text mb-3">Wind</h3>
          <p class="text-sm text-text-mid leading-relaxed">
            Wind makes a big difference. 15°C with a headwind can feel a lot
            more like 8°C when you're moving. If it's breezy, add a gilet or
            wind jacket, especially on exposed sections and descents.
          </p>
        </div>

        <div class="bg-white rounded-2xl border border-border p-[22px]">
          <h3 class="font-head text-[14px] font-bold text-text mb-3">Rain</h3>
          <p class="text-sm text-text-mid leading-relaxed">
            When there's a real chance of rain, you need a proper waterproof
            jacket, not just something water-resistant. Wet kit stops working
            fast, so waterproof gloves and overshoes are worth it too.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bg-bg border-t border-border">
    <div class="container py-16 md:py-20">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <h2
          class="font-head font-bold text-2xl md:text-3xl tracking-tight text-text mb-3"
        >
          Frequently asked questions
        </h2>
        <p class="text-text-mid leading-relaxed">
          Questions we get asked a lot about cycling kit.
        </p>
      </div>

      <div class="max-w-3xl mx-auto divide-y divide-border">
        <details class="group py-5">
          <summary
            class="faq-summary flex items-center justify-between gap-4 cursor-pointer font-head font-semibold text-text"
          >
            When do I need a cycling gilet?
            <svg
              class="size-4 text-text-light shrink-0 transition-transform duration-200 group-open:rotate-180"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <p class="mt-3 text-sm text-text-mid leading-relaxed pr-8">
            Roughly between 10 and 16°C, especially if it's windy. A gilet keeps
            your chest warm on descents without making you overheat on climbs,
            and it folds small enough to stuff in a jersey pocket. If rain is in
            the forecast, go with a waterproof jacket instead.
          </p>
        </details>

        <details class="group py-5">
          <summary
            class="faq-summary flex items-center justify-between gap-4 cursor-pointer font-head font-semibold text-text"
          >
            What cycling kit do I need for riding in rain?
            <svg
              class="size-4 text-text-light shrink-0 transition-transform duration-200 group-open:rotate-180"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <p class="mt-3 text-sm text-text-mid leading-relaxed pr-8">
            A proper waterproof jacket, not just something water-resistant. Your
            hands and feet get cold fast when wet, so waterproof gloves and
            overshoes are worth it. A peaked cap under your helmet keeps the
            rain out of your eyes. kitcheck.cc picks this up from the forecast
            and adds the right layers for you.
          </p>
        </details>

        <details class="group py-5">
          <summary
            class="faq-summary flex items-center justify-between gap-4 cursor-pointer font-head font-semibold text-text"
          >
            Does ride intensity affect what cycling kit I need?
            <svg
              class="size-4 text-text-light shrink-0 transition-transform duration-200 group-open:rotate-180"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <p class="mt-3 text-sm text-text-mid leading-relaxed pr-8">
            Yes, a lot. Going hard warms you up fast and you'll quickly overheat
            in kit that felt fine at the start. Set your intensity in the
            calculator (easy through to race pace) and it adjusts the
            recommendation so you're not stopping to strip layers halfway
            through.
          </p>
        </details>

        <details class="group py-5">
          <summary
            class="faq-summary flex items-center justify-between gap-4 cursor-pointer font-head font-semibold text-text"
          >
            Should I wear bib shorts or bib tights?
            <svg
              class="size-4 text-text-light shrink-0 transition-transform duration-200 group-open:rotate-180"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <p class="mt-3 text-sm text-text-mid leading-relaxed pr-8">
            Bib tights below about 8°C, then bib shorts with leg warmers from
            8–11°C, and bib shorts with knee warmers for the 11–14°C range.
            Above 14°C bib shorts alone are usually fine — knee warmers still
            help on cold starts or long descents. Wind and rain push those
            thresholds up. kitcheck.cc picks the right option based on your
            conditions.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-bg-dark">
    <div class="container py-12 md:py-14">
      <div
        class="flex flex-col sm:flex-row sm:items-center justify-between gap-6"
      >
        <div>
          <p class="font-head font-bold text-xl text-white mb-1">
            Try the calculator
          </p>
          <p class="text-sm text-white/60">
            Search your location and get a full kit recommendation in seconds.
          </p>
        </div>
        <a href="/" class="btn-primary">Use the calculator</a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <SiteFooter />

  <style>
    .faq-summary {
      list-style: none;
    }
    .faq-summary::-webkit-details-marker {
      display: none;
    }
  </style>
</Base>
