---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const faqSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What should I wear cycling at 0°C?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At 0°C you need a thermal base layer, a thermal long-sleeve jersey, a windproof or insulated jacket, thermal bib tights, thermal full-finger gloves, a thermal cap under your helmet, and waterproof overshoes. Wind chill and precipitation make it feel significantly colder — kitcheck.cc factors these in automatically.",
          },
        },
        {
          "@type": "Question",
          name: "What should I wear cycling at 5°C?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At 5°C wear a base layer, a thermal long-sleeve jersey or lightweight thermal jacket, thermal bib tights, light thermal gloves, and toe covers or overshoes. A thin skull cap or ear covers under your helmet helps considerably. Harder efforts generate enough heat to drop one layer on the upper body.",
          },
        },
        {
          "@type": "Question",
          name: "What should I wear cycling at 10°C?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At 10°C most cyclists need a long-sleeve jersey with arm warmers, bib tights or knee warmers, light gloves, and toe covers. At moderate-to-hard intensity you may only need knee warmers rather than full tights. kitcheck.cc adjusts the recommendation automatically based on your effort level.",
          },
        },
        {
          "@type": "Question",
          name: "What should I wear cycling at 15°C?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At 15°C a short-sleeve jersey with arm warmers is a versatile choice — you can roll them down as you warm up. Bib shorts are usually comfortable; add knee warmers if it feels cool or windy. Lightweight gloves are optional. No overshoes needed unless rain is forecast.",
          },
        },
        {
          "@type": "Question",
          name: "What should I wear cycling at 20°C?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At 20°C bib shorts and a short-sleeve jersey are the standard choice for most riders. Gloves are optional. If temperatures drop on a long descent or later in the day, a thin gilet in your back pocket provides useful backup.",
          },
        },
        {
          "@type": "Question",
          name: "When do I need a cycling gilet?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A gilet is ideal between 10–16°C with wind, or on routes with long descents. It keeps your core warm without overheating on climbs, and packs into a jersey pocket easily. In rain, swap it for a waterproof jacket instead.",
          },
        },
        {
          "@type": "Question",
          name: "What cycling kit do I need for riding in rain?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For rain you need a waterproof cycling jacket (not just water-resistant), waterproof gloves, and overshoes to keep your feet dry. A cap with a peak under your helmet keeps rain off your face. kitcheck.cc detects high precipitation probability and adds a waterproof layer to the recommendation automatically.",
          },
        },
        {
          "@type": "Question",
          name: "Does ride intensity affect what cycling kit I need?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes — intensity is one of the biggest variables. A hard race effort can generate as much warmth as a 5–8°C temperature increase compared to an easy ride. kitcheck.cc lets you select your effort level (easy, moderate, hard, race) and adjusts the kit recommendation accordingly, so you don't overheat or underdress.",
          },
        },
        {
          "@type": "Question",
          name: "Should I wear bib shorts or bib tights?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The crossover point for most cyclists is around 12–14°C: below that, knee warmers or thermal bib tights keep muscles warmer and reduce injury risk. Above it, bib shorts with optional knee warmers give more flexibility. Wind and rain lower the effective threshold. kitcheck.cc recommends the right lower-body option based on your local conditions.",
          },
        },
      ],
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "kitcheck.cc",
          item: "https://kitcheck.cc",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Cycling Kit Guide",
          item: "https://kitcheck.cc/guide",
        },
      ],
    },
  ],
};
---

<Base
  title="Cycling Kit Temperature Guide | kitcheck.cc"
  description="Find out what to wear cycling at every temperature, from 0°C to 20°C and beyond. Includes notes on how intensity, wind and rain affect what you actually need."
  canonical="https://kitcheck.cc/guide"
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    />
  </Fragment>

  <!-- HEADER -->
  <SiteHeader>
    <a href="/" class="btn-primary">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="size-4 rotate-180"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        ><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
        ></path></svg
      >
      <span class="hidden sm:inline">Use the calculator</span>
    </a>
  </SiteHeader>

  <!-- PAGE INTRO -->
  <section class="bg-bg">
    <div class="container">
      <div class="max-w-2xl pt-16 md:pt-18 lg:pt-20 pb-12 md:pb-14">
        <nav class="flex items-center gap-2 text-xs text-text-light mb-5">
          <a href="/" class="hover:text-text-mid transition-colors"
            >kitcheck.cc</a
          >
          <span>›</span>
          <span class="text-text-mid">Cycling Kit Guide</span>
        </nav>
        <h1
          class="font-head text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.1] text-text mb-4"
        >
          Cycling kit by temperature
        </h1>
        <p class="text-text-mid leading-relaxed max-w-xl">
          Temperature matters most, but your effort level, the wind and whether
          it's raining all make a real difference. Browse the guide below or use <a
            href="/"
            class="text-coral hover:opacity-75 transition-opacity"
            >kitcheck.cc</a
          > to get a recommendation based on the actual forecast.
        </p>
      </div>
    </div>
  </section>

  <!-- TEMPERATURE GUIDE -->
  <section class="bg-bg border-t border-border">
    <div class="container py-16 md:py-20">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 mb-12">
        <div class="bg-white rounded-2xl border border-border p-[22px]">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#5B8FD4]"
            ></span>
            <span class="font-head font-semibold text-sm text-text">≤ 5 °C</span
            >
          </div>
          <p
            class="font-head text-[11px] font-semibold tracking-[0.08em] uppercase text-text-mid mb-3"
          >
            Very cold
          </p>
          <ul class="space-y-1.5 text-sm text-text-mid">
            <li>Thermal base layer</li>
            <li>Insulated jacket</li>
            <li>Thermal bib tights</li>
            <li>Thermal full-finger gloves</li>
            <li>Thermal cap + overshoes</li>
          </ul>
        </div>

        <div class="bg-white rounded-2xl border border-border p-[22px]">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#74A9D8]"
            ></span>
            <span class="font-head font-semibold text-sm text-text"
              >6 – 12 °C</span
            >
          </div>
          <p
            class="font-head text-[11px] font-semibold tracking-[0.08em] uppercase text-text-mid mb-3"
          >
            Cold
          </p>
          <ul class="space-y-1.5 text-sm text-text-mid">
            <li>Long-sleeve jersey</li>
            <li>Wind or rain gilet</li>
            <li>Bib tights or knee warmers</li>
            <li>Light gloves</li>
            <li>Toe covers</li>
          </ul>
        </div>

        <div class="bg-white rounded-2xl border border-border p-[22px]">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#6DBF8A]"
            ></span>
            <span class="font-head font-semibold text-sm text-text"
              >13 – 16 °C</span
            >
          </div>
          <p
            class="font-head text-[11px] font-semibold tracking-[0.08em] uppercase text-text-mid mb-3"
          >
            Mild
          </p>
          <ul class="space-y-1.5 text-sm text-text-mid">
            <li>Short-sleeve jersey</li>
            <li>Arm warmers (rollable)</li>
            <li>Bib shorts</li>
            <li>Thin gloves optional</li>
            <li>Gilet in pocket</li>
          </ul>
        </div>

        <div class="bg-white rounded-2xl border border-border p-[22px]">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#FF7A1A]"
            ></span>
            <span class="font-head font-semibold text-sm text-text"
              >17 – 22 °C</span
            >
          </div>
          <p
            class="font-head text-[11px] font-semibold tracking-[0.08em] uppercase text-text-mid mb-3"
          >
            Warm
          </p>
          <ul class="space-y-1.5 text-sm text-text-mid">
            <li>Short-sleeve jersey</li>
            <li>Bib shorts</li>
            <li>No gloves</li>
            <li>Sunglasses</li>
            <li>Gilet for long descents</li>
          </ul>
        </div>

        <div class="bg-white rounded-2xl border border-border p-[22px]">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-coral"></span>
            <span class="font-head font-semibold text-sm text-text"
              >≥ 23 °C</span
            >
          </div>
          <p
            class="font-head text-[11px] font-semibold tracking-[0.08em] uppercase text-text-mid mb-3"
          >
            Hot
          </p>
          <ul class="space-y-1.5 text-sm text-text-mid">
            <li>Lightweight jersey</li>
            <li>Bib shorts</li>
            <li>No gloves</li>
            <li>Sunglasses</li>
            <li>Prioritise hydration</li>
          </ul>
        </div>
      </div>

      <!-- Other factors -->
      <h2 class="font-head font-bold text-xl text-text mb-5">
        Other factors that shift the recommendation
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <div class="bg-white rounded-2xl border border-border p-[22px]">
          <h3 class="font-head text-[14px] font-bold text-text mb-3">
            Ride intensity
          </h3>
          <p class="text-sm text-text-mid leading-relaxed">
            The harder you ride, the warmer you get. A race-pace effort can
            easily mean one or two fewer layers than on a steady endurance spin.
            Set your intensity in the calculator and it adjusts the
            recommendation for you.
          </p>
        </div>

        <div class="bg-white rounded-2xl border border-border p-[22px]">
          <h3 class="font-head text-[14px] font-bold text-text mb-3">Wind</h3>
          <p class="text-sm text-text-mid leading-relaxed">
            Wind makes a big difference. 15°C with a headwind can feel a lot
            more like 8°C when you're moving. If it's breezy, add a gilet or
            wind jacket, especially on exposed sections and descents.
          </p>
        </div>

        <div class="bg-white rounded-2xl border border-border p-[22px]">
          <h3 class="font-head text-[14px] font-bold text-text mb-3">Rain</h3>
          <p class="text-sm text-text-mid leading-relaxed">
            When there's a real chance of rain, you need a proper waterproof
            jacket, not just something water-resistant. Wet kit stops working
            fast, so waterproof gloves and overshoes are worth it too.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bg-bg border-t border-border">
    <div class="container py-16 md:py-20">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <h2
          class="font-head font-bold text-2xl md:text-3xl tracking-tight text-text mb-3"
        >
          Frequently asked questions
        </h2>
        <p class="text-text-mid leading-relaxed">
          Questions we get asked a lot about cycling kit.
        </p>
      </div>

      <div class="max-w-3xl mx-auto divide-y divide-border">
        <details class="group py-5">
          <summary
            class="faq-summary flex items-center justify-between gap-4 cursor-pointer font-head font-semibold text-text"
          >
            What should I wear cycling at 0 °C?
            <svg
              class="size-4 text-text-light shrink-0 transition-transform duration-200 group-open:rotate-180"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <p class="mt-3 text-sm text-text-mid leading-relaxed pr-8">
            Full winter kit. Thermal base layer, thermal long-sleeve jersey and
            a windproof or insulated jacket on top. Thermal bib tights,
            full-finger thermal gloves, a cap under your helmet and waterproof
            overshoes. With wind and rain it can feel even colder, so
            kitcheck.cc factors those in too.
          </p>
        </details>

        <details class="group py-5">
          <summary
            class="faq-summary flex items-center justify-between gap-4 cursor-pointer font-head font-semibold text-text"
          >
            What should I wear cycling at 5 °C?
            <svg
              class="size-4 text-text-light shrink-0 transition-transform duration-200 group-open:rotate-180"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <p class="mt-3 text-sm text-text-mid leading-relaxed pr-8">
            Base layer, thermal long-sleeve jersey, thermal bib tights, light
            thermal gloves and toe covers or overshoes. A thin cap or ear covers
            make a real difference in the cold. If you're riding hard you might
            get away without a jacket on top, but keep one within reach.
          </p>
        </details>

        <details class="group py-5">
          <summary
            class="faq-summary flex items-center justify-between gap-4 cursor-pointer font-head font-semibold text-text"
          >
            What should I wear cycling at 10 °C?
            <svg
              class="size-4 text-text-light shrink-0 transition-transform duration-200 group-open:rotate-180"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <p class="mt-3 text-sm text-text-mid leading-relaxed pr-8">
            Long-sleeve jersey with arm warmers, bib tights or knee warmers,
            light gloves and toe covers. If you're riding at a decent pace, knee
            warmers often do the job instead of full tights. This is the range
            where your intensity makes the biggest difference to what you'll
            actually need.
          </p>
        </details>

        <details class="group py-5">
          <summary
            class="faq-summary flex items-center justify-between gap-4 cursor-pointer font-head font-semibold text-text"
          >
            What should I wear cycling at 15 °C?
            <svg
              class="size-4 text-text-light shrink-0 transition-transform duration-200 group-open:rotate-180"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <p class="mt-3 text-sm text-text-mid leading-relaxed pr-8">
            Short-sleeve jersey with arm warmers is the classic choice. You can
            roll them down once you warm up. Bib shorts are fine for most
            riders; throw on knee warmers if it feels fresh or breezy. Gloves
            are optional and you can leave the overshoes at home unless rain is
            on the way.
          </p>
        </details>

        <details class="group py-5">
          <summary
            class="faq-summary flex items-center justify-between gap-4 cursor-pointer font-head font-semibold text-text"
          >
            What should I wear cycling at 20 °C?
            <svg
              class="size-4 text-text-light shrink-0 transition-transform duration-200 group-open:rotate-180"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <p class="mt-3 text-sm text-text-mid leading-relaxed pr-8">
            Bib shorts and a short-sleeve jersey. That's it for most people.
            Stuff a thin gilet in your back pocket if you've got big descents or
            a long ride planned, but you probably won't need it.
          </p>
        </details>

        <details class="group py-5">
          <summary
            class="faq-summary flex items-center justify-between gap-4 cursor-pointer font-head font-semibold text-text"
          >
            When do I need a cycling gilet?
            <svg
              class="size-4 text-text-light shrink-0 transition-transform duration-200 group-open:rotate-180"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <p class="mt-3 text-sm text-text-mid leading-relaxed pr-8">
            Roughly between 10 and 16°C, especially if it's windy. A gilet keeps
            your chest warm on descents without making you overheat on climbs,
            and it folds small enough to stuff in a jersey pocket. If rain is in
            the forecast, go with a waterproof jacket instead.
          </p>
        </details>

        <details class="group py-5">
          <summary
            class="faq-summary flex items-center justify-between gap-4 cursor-pointer font-head font-semibold text-text"
          >
            What cycling kit do I need for riding in rain?
            <svg
              class="size-4 text-text-light shrink-0 transition-transform duration-200 group-open:rotate-180"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <p class="mt-3 text-sm text-text-mid leading-relaxed pr-8">
            A proper waterproof jacket, not just something water-resistant. Your
            hands and feet get cold fast when wet, so waterproof gloves and
            overshoes are worth it. A peaked cap under your helmet keeps the
            rain out of your eyes. kitcheck.cc picks this up from the forecast
            and adds the right layers for you.
          </p>
        </details>

        <details class="group py-5">
          <summary
            class="faq-summary flex items-center justify-between gap-4 cursor-pointer font-head font-semibold text-text"
          >
            Does ride intensity affect what cycling kit I need?
            <svg
              class="size-4 text-text-light shrink-0 transition-transform duration-200 group-open:rotate-180"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <p class="mt-3 text-sm text-text-mid leading-relaxed pr-8">
            Yes, a lot. Going hard warms you up fast and you'll quickly overheat
            in kit that felt fine at the start. Set your intensity in the
            calculator (easy through to race pace) and it adjusts the
            recommendation so you're not stopping to strip layers halfway
            through.
          </p>
        </details>

        <details class="group py-5">
          <summary
            class="faq-summary flex items-center justify-between gap-4 cursor-pointer font-head font-semibold text-text"
          >
            Should I wear bib shorts or bib tights?
            <svg
              class="size-4 text-text-light shrink-0 transition-transform duration-200 group-open:rotate-180"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <p class="mt-3 text-sm text-text-mid leading-relaxed pr-8">
            Most people switch somewhere around 12 to 14°C. Below that your legs
            get cold fast, especially on longer rides. Above it bib shorts are
            usually fine, maybe with knee warmers if it feels fresh. Wind and
            rain both push that threshold up. kitcheck.cc picks the right option
            based on your conditions.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-bg-dark">
    <div class="container py-12 md:py-14">
      <div
        class="flex flex-col sm:flex-row sm:items-center justify-between gap-6"
      >
        <div>
          <p class="font-head font-bold text-xl text-white mb-1">
            Try the calculator
          </p>
          <p class="text-sm text-white/60">
            Search your location and get a full kit recommendation in seconds.
          </p>
        </div>
        <a href="/" class="btn-primary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-4 rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"></path></svg
          >
          Use the calculator
        </a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <SiteFooter />

  <style>
    .faq-summary {
      list-style: none;
    }
    .faq-summary::-webkit-details-marker {
      display: none;
    }
  </style>
</Base>
