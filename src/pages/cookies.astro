---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Base
  title="Cookie Policy | kitcheck.cc"
  description="Cookie policy for kitcheck.cc. What cookies and storage we use, and why."
  canonical="https://kitcheck.cc/cookies/"
>
  <SiteHeader>
    <a href="/" class="btn-primary">Use the calculator</a>
  </SiteHeader>

  <section class="bg-bg">
    <div class="container">
      <div class="max-w-2xl pt-16 md:pt-18 lg:pt-20 pb-12 md:pb-14">
        <nav class="flex items-center gap-2 text-xs text-text-light mb-5">
          <a href="/" class="hover:text-text-mid transition-colors">kitcheck.cc</a>
          <span>›</span>
          <span class="text-text-mid">Cookie policy</span>
        </nav>
        <h1 class="font-head text-3xl md:text-4xl font-bold tracking-tight leading-[1.1] text-text mb-4">
          Cookie policy
        </h1>
        <p class="text-text-mid leading-relaxed">
          Last updated: October 2026
        </p>
      </div>
    </div>
  </section>

  <section class="bg-bg border-t border-border">
    <div class="container py-14 md:py-18">
      <div class="max-w-2xl prose-custom">

        <h2>In short</h2>
        <p>
          Without your consent, kitcheck.cc sets no cookies. Analytics cookies from Google
          Analytics are only placed after you click <em>Accept</em>.
        </p>

        <div class="consent-box">
          <p class="consent-status">Your current choice: <strong id="consent-status">…</strong></p>
          <button type="button" data-consent-open class="btn-secondary">Change cookie settings</button>
        </div>

        <h2>Storage that doesn't need consent</h2>
        <p>
          These only remember choices you make yourself, stay in your browser and are never
          sent to us or anyone else.
        </p>
        <div class="cookie-table-wrap">
          <table>
            <thead><tr><th>Name</th><th>Type</th><th>Purpose</th><th>Expires</th></tr></thead>
            <tbody>
              <tr>
                <td><code>kitcheck-consent</code></td>
                <td>Local storage</td>
                <td>Remembers whether you accepted or declined analytics, and when</td>
                <td>12 months, then we ask again</td>
              </tr>
              <tr>
                <td><code>kitcheck-speed</code></td>
                <td>Local storage</td>
                <td>Remembers the average speed you set for GPX routes, so your next route uses it too</td>
                <td>Until you choose <em>Use estimate</em> or clear your browser data</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Our host Cloudflare may set a security cookie (such as <code>__cf_bm</code>) when it
          needs to tell real visitors from bots. It is strictly necessary and contains no
          analytics data.
        </p>

        <h2>Analytics cookies (only with consent)</h2>
        <p>
          Set by Google Analytics 4 after you click <em>Accept</em>, to recognise a returning
          browser and measure how the calculator is used. Advertising features are switched off.
        </p>
        <div class="cookie-table-wrap">
          <table>
            <thead><tr><th>Name</th><th>Provider</th><th>Purpose</th><th>Expires</th></tr></thead>
            <tbody>
              <tr>
                <td><code>_ga</code></td>
                <td>Google</td>
                <td>Distinguishes browsers with a random ID</td>
                <td>2 years</td>
              </tr>
              <tr>
                <td><code>_ga_FSYJ9GNCNP</code></td>
                <td>Google</td>
                <td>Keeps track of the current session</td>
                <td>2 years</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          If you later choose <em>Decline</em>, Google Analytics stops immediately and these
          cookies are deleted.
        </p>


        <h2>No other cookies</h2>
        <p>
          There are no advertising, social media or tracking pixels on kitcheck.cc. Fonts are
          served from our own domain, and the weather and map services we use don't set cookies.
        </p>

        <h2>Questions</h2>
        <p>
          Contact <a href="mailto:privacy@kitcheck.cc">privacy@kitcheck.cc</a>.
        </p>

      </div>
    </div>
  </section>

  <SiteFooter />

  <script>
    import { getConsent } from '../lib/consent'
    const el = document.getElementById('consent-status')!
    const render = () => {
      const c = getConsent()
      el.textContent = c === 'accepted' ? 'Analytics accepted' : c === 'declined' ? 'Analytics declined' : 'No choice made yet'
    }
    render()
    window.addEventListener('kitcheck:consent-change', render)
  </script>
</Base>

<style>
  .prose-custom h2 {
    font-family: var(--font-head, inherit);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .prose-custom p,
  .prose-custom ul {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-text-mid);
    margin-bottom: 1rem;
  }
  .prose-custom a {
    color: var(--color-coral);
    text-decoration: none;
  }
  .prose-custom a:hover {
    opacity: 0.75;
  }
  .prose-custom code {
    font-size: 0.8125rem;
    background: #f3f4f6;
    border-radius: 4px;
    padding: 1px 5px;
    color: var(--color-text);
  }
  .consent-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 14px 16px;
    margin: 0.5rem 0 1.5rem;
  }
  .prose-custom .consent-status {
    margin: 0;
    color: var(--color-text);
  }
  .cookie-table-wrap {
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  th,
  td {
    padding-left: 8px !important;
    padding-right: 8px !important;
  }
  td code {
    word-break: break-all;
  }
  th {
    text-align: left;
    font-family: var(--font-head, inherit);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-mid);
    padding: 8px 12px;
    border-bottom: 1px solid var(--color-border);
  }
  td {
    padding: 10px 12px;
    font-size: 0.8125rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-mid);
    vertical-align: top;
  }
  tr:last-child td {
    border-bottom: none;
  }
</style>
